                    <button name="action_itineraire_google_maps" type="object" class="btn btn-link p-0"
                            icon="directions_car" string="Itinéraire"/>
                </div>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <separator string="Carte" invisible="not carte_google"/>
                <field name="carte_google" nolabel="1" readonly="1" invisible="not carte_google"/>
            </xpath>
        </field>
    </record>

    <!-- ============================================================ Tickets -->
    <record id="view_ticket_form_carte" model="ir.ui.view">
        <field name="name">helpdesk.ticket.form.carte</field>
        <field name="model">helpdesk.ticket</field>
