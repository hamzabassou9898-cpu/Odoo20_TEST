                    <button name="action_itineraire_google_maps" type="object" class="btn btn-link p-0"
                            icon="directions_car" string="Itinéraire"/>
                </div>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Carte" name="carte_google" invisible="not carte_google">
                    <field name="carte_google" nolabel="1" readonly="1"/>
                </page>
            </xpath>
        </field>
    </record>

    <!-- ============================================================ Machines -->
    <record id="view_lot_form_carte" model="ir.ui.view">
        <field name="name">stock.lot.form.carte</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="suivi_machines.view_lot_form_machine"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='machine_client_id']" position="after">
                <field name="lien_google_maps" invisible="1"/>
