<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ Transferts -->
    <record id="view_picking_form_carte" model="ir.ui.view">
        <field name="name">stock.picking.form.carte</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='route']" position="after">
                <field name="lien_google_maps" invisible="1"/>
                <div colspan="2" class="d-flex flex-wrap gap-3 mb-2" invisible="not lien_google_maps">
                    <button name="action_ouvrir_google_maps" type="object" class="btn btn-link p-0"
                            icon="location_on" string="Voir sur Google Maps"/>
                    <button name="action_itineraire_google_maps" type="object" class="btn btn-link p-0"
                            icon="directions_car" string="Itinéraire"/>
                </div>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Carte" name="carte_google" invisible="not carte_google">
                    <field name="carte_google" nolabel="1" readonly="1"/>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Portail livreurs : liens Google Maps sur chaque carte -->
    <record id="view_portail_livreurs_kanban_carte" model="ir.ui.view">
        <field name="name">stock.picking.portail.livreurs.kanban.carte</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="suivi_machines_pilotage.view_portail_livreurs_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//kanban/field[@name='livreur_id']" position="after">
                <field name="lien_google_maps"/>
                <field name="lien_itineraire"/>
            </xpath>
            <xpath expr="//div[field[@name='route']]" position="after">
                <div class="d-flex gap-3 small mt-1" t-if="record.lien_google_maps.raw_value">
                    <a t-att-href="record.lien_google_maps.raw_value" target="_blank" rel="noopener"
                       title="Voir l'adresse sur Google Maps">
                        <i class="oi me-1" data-icon="location_on"/>Google Maps
                    </a>
                    <a t-att-href="record.lien_itineraire.raw_value" target="_blank" rel="noopener"
                       title="Itinéraire depuis ma position">
                        <i class="oi me-1" data-icon="directions_car"/>Itinéraire
                    </a>
                </div>
            </xpath>
        </field>
    </record>

    <!-- Plusieurs transferts choisis : un seul itineraire, dans l'ordre des dates -->
    <record id="action_server_itineraire_tournee" model="ir.actions.server">
        <field name="name">Itinéraire Google Maps</field>
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_view_types">list,kanban</field>
        <field name="state">code</field>
        <field name="code">action = records.action_itineraire_tournee()</field>
    </record>

    <!-- Portail techniciens : liens Google Maps sur chaque carte -->
    <record id="view_portail_techniciens_kanban_carte" model="ir.ui.view">
        <field name="name">portail.tache.kanban.carte</field>
        <field name="model">portail.tache</field>
        <field name="inherit_id" ref="suivi_machines_pilotage.view_portail_techniciens_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//kanban/field[@name='technicien_id']" position="after">
                <field name="lien_google_maps"/>
                <field name="lien_itineraire"/>
            </xpath>
            <xpath expr="//div[field[@name='route']]" position="after">
                <div class="d-flex gap-3 small mt-1" t-if="record.lien_google_maps.raw_value">
                    <a t-att-href="record.lien_google_maps.raw_value" target="_blank" rel="noopener"
                       title="Voir l'adresse sur Google Maps">
                        <i class="oi me-1" data-icon="location_on"/>Google Maps
                    </a>
                    <a t-att-href="record.lien_itineraire.raw_value" target="_blank" rel="noopener"
                       title="Itinéraire depuis ma position">
                        <i class="oi me-1" data-icon="directions_car"/>Itinéraire
                    </a>
                </div>
            </xpath>
        </field>
    </record>

    <!-- Fiche de la tache : boutons Google Maps et apercu de la carte -->
    <record id="view_portail_techniciens_form_carte" model="ir.ui.view">
        <field name="name">portail.tache.form.carte</field>
        <field name="model">portail.tache</field>
        <field name="inherit_id" ref="suivi_machines_pilotage.view_portail_techniciens_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='route']" position="after">
                <field name="lien_google_maps" invisible="1"/>
                <div colspan="2" class="d-flex flex-wrap gap-3 mb-2" invisible="not lien_google_maps">
                    <button name="action_ouvrir_google_maps" type="object" class="btn btn-link p-0"
                            icon="location_on" string="Voir sur Google Maps"/>
                    <button name="action_itineraire_google_maps" type="object" class="btn btn-link p-0"
                            icon="directions_car" string="Itinéraire"/>
                </div>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <field name="carte_google" nolabel="1" readonly="1" invisible="not carte_google"/>
            </xpath>
        </field>
    </record>

    <record id="action_server_itineraire_taches" model="ir.actions.server">
        <field name="name">Itinéraire Google Maps</field>
        <field name="model_id" ref="suivi_machines_pilotage.model_portail_tache"/>
        <field name="binding_model_id" ref="suivi_machines_pilotage.model_portail_tache"/>
        <field name="binding_view_types">list,kanban</field>
        <field name="state">code</field>
        <field name="code">action = records.action_itineraire_tournee()</field>
    </record>

