<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="tag_entretien_retard" model="helpdesk.tag">
        <field name="name">Entretiens en retard</field>
        <field name="color">1</field>
    </record>
    <record id="tag_entretien_semaine" model="helpdesk.tag">
        <field name="name">Entretiens à faire cette semaine</field>
        <field name="color">2</field>
    </record>
    <record id="param_jours_avant_entretien" model="ir.config_parameter">
        <field name="key">suivi_machines_helpdesk.jours_avant_entretien</field>
        <field name="value">7</field>
    </record>
    <record id="cron_tickets_entretien" model="ir.cron">
        <field name="name">Suivi des machines : tickets d'entretien (en retard / cette semaine)</field>
        <field name="model_id" ref="helpdesk.model_helpdesk_ticket"/>
        <field name="state">code</field>
        <field name="code">model._cron_tickets_entretien()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
</odoo>
