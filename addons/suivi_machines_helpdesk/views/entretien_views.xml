<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_verifier_entretiens" model="ir.actions.server">
        <field name="name">Vérifier les entretiens</field>
        <field name="model_id" ref="helpdesk.model_helpdesk_ticket"/>
        <field name="state">code</field>
        <field name="code">action = model._action_verifier_entretiens()</field>
    </record>
    <menuitem id="menu_verifier_entretiens" name="Vérifier les entretiens"
              parent="suivi_machines.menu_machines" action="action_verifier_entretiens" sequence="5"/>

    <record id="view_valider_entretien_form" model="ir.ui.view">
        <field name="name">suivi.machines.valider.entretien.form</field>
        <field name="model">suivi.machines.valider.entretien</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="ticket_id" invisible="1"/>
                    <field name="lot_id" readonly="1"/>
                    <field name="date_entretien"/>
                    <field name="frequence"/>
                    <field name="technicien_id" widget="many2one_avatar_user"/>
                    <field name="note" placeholder="Nettoyage, pièces changées, état de la machine..."/>
                </group>
                <footer>
                    <button name="action_valider" type="object" string="Valider l'entretien" class="btn-primary"/>
                    <button string="Annuler" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
