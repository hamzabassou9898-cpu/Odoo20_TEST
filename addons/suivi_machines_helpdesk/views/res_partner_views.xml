<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_contrat_location" model="ir.ui.view">
        <field name="name">res.partner.form.contrat.location</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <!-- Sous « Etiquettes » : le contrat de location actuel, choisi automatiquement -->
            <xpath expr="//field[@name='category_id']" position="after">
                <field name="contrat_location_id" groups="sales_team.group_sale_salesman"
                       invisible="not contrat_location_id" readonly="1"/>
                <field name="contrat_location_type" groups="sales_team.group_sale_salesman"
                       invisible="not contrat_location_id"/>
                <field name="contrat_location_debut" groups="sales_team.group_sale_salesman"
                       invisible="not contrat_location_debut"/>
                <field name="contrat_location_fin" groups="sales_team.group_sale_salesman"
                       invisible="not contrat_location_fin"/>
            </xpath>
            <!-- Sante du client : un coup d'oeil avant d'appeler -->
            <xpath expr="//notebook" position="before">
                <div class="d-flex flex-wrap align-items-stretch gap-2 mb-3" groups="sales_team.group_sale_salesman"
                     invisible="not sante_niveau">
                    <field name="sante_devise_id" invisible="1"/>
                    <div class="border rounded px-3 py-2 d-flex flex-column justify-content-center">
                        <field name="sante_niveau" widget="badge" class="fs-6"
                               decoration-success="sante_niveau == 'fidele'"
                               decoration-warning="sante_niveau == 'surveiller'"
                               decoration-danger="sante_niveau == 'risque'"/>
                        <field name="sante_raison" class="small text-muted" invisible="not sante_raison"/>
                    </div>
                    <!-- Cliquable : la liste des machines chez le client -->
                    <button name="action_machines_chez_client" type="object" title="Voir les machines chez le client"
                            class="btn btn-light border rounded px-3 py-2 text-start">
                        <div class="fs-4 fw-bold"><field name="sante_nb_machines"/></div>
                        <div class="small text-muted">Machines chez lui ›</div>
                    </button>
                    <div class="border rounded px-3 py-2">
                        <div class="fs-4 fw-bold"><field name="sante_nb_appels"/></div>
                        <div class="small text-muted">Appels (12 mois)</div>
                    </div>
                    <div class="border rounded px-3 py-2">
                        <div class="fs-4 fw-bold"><field name="sante_impayes" decoration-danger="sante_impayes &gt; 0"/></div>
                        <div class="small text-muted">Impayés</div>
                    </div>
                    <div class="border rounded px-3 py-2">
                        <div class="fs-4 fw-bold"><field name="sante_chiffre"/></div>
                        <div class="small text-muted">Chiffre d'affaires total</div>
                    </div>
                </div>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Historique d'achat" name="historique_achat" groups="sales_team.group_sale_salesman"
                      invisible="not historique_achat_ids">
                    <field name="historique_achat_ids" readonly="1" nolabel="1">
                        <list create="false" edit="false" delete="false" default_order="date_order desc">
                            <field name="date_order" string="Date"/>
                            <field name="name" string="N° de bon / contrat de location"/>
                            <field name="type_commande" widget="badge" decoration-info="type_commande == 'location'"
                                   decoration-success="type_commande == 'vente'"/>
                            <field name="date_fin_location" string="Fin de location"/>
                            <field name="amount_untaxed" string="Montant (HT)" sum="Total"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
