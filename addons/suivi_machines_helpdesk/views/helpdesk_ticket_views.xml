<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="helpdesk_ticket_view_form_machine" model="ir.ui.view">
        <field name="name">helpdesk.ticket.form.suivi.machines</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_ticket_view_form"/>
        <field name="arch" type="xml">
            <!-- Bouton intelligent en haut : fiche de la machine choisie -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_fiche_machine" type="object" class="oe_stat_button"
                        icon="precision_manufacturing" invisible="not lot_id">
                    <div class="o_stat_info">
                        <span class="o_stat_value"><field name="machine_numero"/></span>
                        <span class="o_stat_text">Fiche de machine</span>
                    </div>
                </button>
                <button name="action_voir_interventions_ticket" type="object" class="oe_stat_button"
                        icon="build" invisible="not nb_interventions_ticket">
                    <field name="nb_interventions_ticket" widget="statinfo" string="Interventions"/>
                </button>
                <button name="action_voir_ventes" type="object" class="oe_stat_button"
                        icon="receipt_long" invisible="not nb_ventes" groups="sales_team.group_sale_salesman">
                    <field name="nb_ventes" widget="statinfo" string="Bons de vente"/>
                </button>
                <button name="action_voir_livraisons" type="object" class="oe_stat_button"
                        icon="local_shipping" invisible="not nb_livraisons" groups="stock.group_stock_user">
                    <field name="nb_livraisons" widget="statinfo" string="Livraisons"/>
                </button>
            </xpath>

            <!-- Boutons d'action en haut du ticket, a cote des etapes -->
            <xpath expr="//header" position="inside">
                <button name="action_nouvelle_intervention" type="object" string="Nouvelle intervention"
                        class="btn-secondary" invisible="not partner_id"/>
                <button name="action_creer_vente" type="object" string="Bon de vente"
                        class="btn-secondary" invisible="not partner_id"
                        groups="sales_team.group_sale_salesman"/>
                <button name="action_creer_livraison" type="object" string="Livraison"
                        class="btn-secondary" invisible="not partner_id" groups="stock.group_stock_user"/>
            </xpath>

            <!-- Technicien de la derniere intervention, sous « Assigné à » -->
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="technicien_id" invisible="not technicien_id" widget="many2one_avatar_user"/>
            </xpath>

            <!-- Adresse du commerce sous le telephone natif -->
            <xpath expr="//field[@name='partner_phone']" position="after">
                <field name="adresse_commerce" invisible="not adresse_commerce"/>
            </xpath>

            <!-- Code client obligatoire : il remplit le client et ses machines -->
            <xpath expr="//field[@name='partner_id']" position="before">
                <field name="code_client" required="1" placeholder="ex. MON134"
                       class="fw-bold"/>
            </xpath>

            <!-- 1. Identification du client  /  2. Parc machines du client -->
            <xpath expr="//field[@name='partner_id']/ancestor::group[last()]" position="after">
                <group name="dossier_client_machine" invisible="not commerce_id">
                    <!-- Client, telephone (natifs) et adresse : en haut, sans doublon -->
                    <group string="1. Identification du client" invisible="commercial_partner_id == commerce_id">
                        <field name="commerce_id" invisible="1"/>
                        <field name="commercial_partner_id" string="Nom de la bannière"/>
                    </group>
                    <group string="2. Parc machines du client">
                        <field name="machines_client_ids" invisible="1"/>
                        <field name="nb_machines_client"/>
                        <field name="machine_numero" invisible="not lot_id"/>
                        <field name="machine_modele_id" invisible="not lot_id"/>
                        <field name="lot_id" options="{'no_create': True}"
                               domain="[('id', 'in', machines_client_ids)]"
                               placeholder="Choisir parmi les machines du client"/>
                        <field name="machine_dernier_entretien" invisible="not lot_id"/>
                        <field name="nb_tickets_precedents" string="Historique des appels de service"/>
                    </group>
                </group>
            </xpath>

            <!-- Onglet natif « Description » renomme « Notes internes » -->
            <xpath expr="//page[.//field[@name='description']]" position="attributes">
                <attribute name="string">Notes internes</attribute>
            </xpath>

            <!-- Onglets d'historique, dans le carnet natif du ticket -->
            <xpath expr="//page[.//field[@name='description']]" position="after">
                    <page string="Historique d'intervention" name="interventions_machine"
                          invisible="not lot_id">
                        <field name="machine_intervention_ids" readonly="1">
                            <list create="false" edit="false" delete="false">
                                <field name="name"/>
                                <field name="date"/>
                                <field name="type" widget="badge"/>
                                <field name="description"/>
                                <field name="user_id" string="Technicien"/>
                                <field name="state" widget="badge"/>
                            </list>
                        </field>
                    </page>
                    <page string="Historique de la machine" name="historique_machine"
                          invisible="not lot_id">
                        <field name="machine_historique_ids" readonly="1">
                            <list create="false" edit="false" delete="false">
                                <field name="date"/>
                                <field name="type" widget="badge"/>
                                <field name="reference"/>
                                <field name="description"/>
                                <field name="partner_id"/>
                                <field name="user_id" optional="hide"/>
                                <field name="state"/>
                            </list>
                        </field>
                    </page>
                    <page string="Appels de service" name="appels_service" invisible="not commerce_id">
                        <field name="tickets_precedents_ids" readonly="1">
                            <list create="false" edit="false" delete="false">
                                <field name="create_date" string="Date"/>
                                <field name="name"/>
                                <field name="lot_id" string="Numéro de série"/>
                                <field name="tag_ids" widget="many2many_tags"/>
                                <field name="priority" widget="priority"/>
                                <field name="user_id"/>
                                <field name="stage_id"/>
                            </list>
                        </field>
                    </page>
                    <page string="Machines chez le client" name="machines_client" invisible="not commerce_id">
                        <field name="machines_client_ids" readonly="1">
                            <list create="false" edit="false" delete="false">
                                <field name="name" string="Numéro de série"/>
                                <field name="ref" string="Numéro de machine"/>
                                <field name="product_id" string="Modèle"/>
                                <field name="machine_statut" widget="badge"/>
                                <field name="date_installation"/>
                                <field name="date_dernier_entretien"/>
                                <field name="date_prochain_entretien"/>
                            </list>
                        </field>
                    </page>
            </xpath>
        </field>
    </record>

    <!-- Kanban : petit badge « Technicien » sur chaque carte, a cote de l'avatar -->
    <record id="helpdesk_ticket_view_kanban_technicien" model="ir.ui.view">
        <field name="name">helpdesk.ticket.kanban.technicien</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_ticket_view_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="before">
                <span t-if="record.technicien_id.raw_value"
                      class="badge rounded-pill text-bg-info me-1 text-truncate" style="max-width: 160px;"
                      title="Technicien de la dernière intervention">
                    Tech : <field name="technicien_id"/>
                </span>
            </xpath>
        </field>
    </record>
</odoo>
