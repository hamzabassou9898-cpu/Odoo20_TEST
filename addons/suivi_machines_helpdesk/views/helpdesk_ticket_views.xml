<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="helpdesk_ticket_view_form_machine" model="ir.ui.view">
        <field name="name">helpdesk.ticket.form.suivi.machines</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_ticket_view_form"/>
        <field name="arch" type="xml">
            <!-- Bouton intelligent en haut : fiche de la machine choisie -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_fiche_machine" type="object" class="oe_stat_button"
                        icon="precision_manufacturing" invisible="not lot_id">
                    <div class="o_stat_info">
                        <span class="o_stat_value"><field name="machine_numero"/></span>
                        <span class="o_stat_text">Fiche de machine</span>
                    </div>
                </button>
                <button name="action_voir_interventions_ticket" type="object" class="oe_stat_button"
                        icon="build" invisible="not nb_interventions_ticket">
                    <field name="nb_interventions_ticket" widget="statinfo" string="Interventions"/>
                </button>
                <button name="action_voir_ventes" type="object" class="oe_stat_button"
                        icon="receipt_long" invisible="not nb_ventes" groups="sales_team.group_sale_salesman">
                    <field name="nb_ventes" widget="statinfo" string="Bons de vente"/>
                </button>
                <button name="action_voir_livraisons" type="object" class="oe_stat_button"
                        icon="local_shipping" invisible="not nb_livraisons" groups="stock.group_stock_user">
                    <field name="nb_livraisons" widget="statinfo" string="Livraisons"/>
                </button>
            </xpath>

            <!-- Boutons d'action en haut du ticket, a cote des etapes -->
            <xpath expr="//header" position="inside">
                <field name="est_reprise" invisible="1"/>
                <field name="est_entretien" invisible="1"/>
                <!-- Ticket de reprise : Ramassage -->
                <button name="action_ramassage" type="object" string="Ramassage"
                        class="btn-primary" invisible="not est_reprise" groups="stock.group_stock_user"/>
                <!-- Machine a remplacer : ramassage de l'ancienne + livraison de la nouvelle, une seule operation -->
                <button name="action_echanger_machine" type="object" string="Échanger la machine" class="btn-primary"
                        invisible="not id or type_demande != 'remplacement' or not lot_remplacement_id or echange_livraison_id"
                        groups="stock.group_stock_user"
                        confirm="Créer le ramassage de l'ancienne machine et la livraison de la nouvelle (validés ensemble) ?"/>
                <!-- Reparation / entretien : l'intervention est planifiee toute seule ; on la termine ici -->
                <button name="action_marquer_fait" type="object" string="Marquer comme fait" class="btn-primary"
                        invisible="not id or est_entretien or type_demande not in ('reparation', 'remplacement') or statut_entretien == 'fait'"
                        confirm="Marquer la réparation comme faite ? L'intervention passe « Faite » et le ticket « Résolu »."/>
                <!-- Entretien : meme bouton, il ouvre la validation (date, prochain entretien) -->
                <button name="action_marquer_fait" type="object" string="Marquer comme fait" class="btn-primary"
                        invisible="not id or not est_entretien or statut_entretien == 'fait'"/>
                <!-- Frais du travail fait (main-d'oeuvre, livraison...) : bon de vente fait depuis le ticket -->
                <button name="action_facturer_frais" type="object" string="Facturer les frais" class="btn-secondary"
                        invisible="not id or not partner_id or type_demande not in ('reparation', 'entretien', 'remplacement', 'ramassage') or (type_demande != 'ramassage' and statut_entretien != 'fait')"
                        groups="sales_team.group_sale_salesman"/>

            </xpath>

            <!-- Bandeau : ticket cree par une action planifiee d'Odoo (d'ou il vient) -->
            <xpath expr="//sheet" position="before">
                <field name="origine_auto" invisible="1"/>
                <div class="alert alert-info mb-0 py-2" role="status" invisible="not origine_auto">
                    Ticket créé <strong>automatiquement par Odoo</strong> (action planifiée)
                    <span invisible="origine_auto != 'entretien'">
                        : l'entretien de cette machine arrive à échéance<span invisible="not date_entretien_prevu">
                        (prévu le <field name="date_entretien_prevu" readonly="1" class="d-inline-block w-auto"/>)</span>.
                    </span>
                    <span invisible="origine_auto != 'retour'">
                        : la machine est revenue à l'entrepôt, son entretien se fait au retour.
                    </span>
                    <span invisible="origine_auto != 'reprise'">
                        : la location <field name="commande_reprise_id" readonly="1" class="d-inline"/>
                        se termine, les machines sont à reprendre.
                    </span>
                </div>
                <!-- Reparation sans date ou sans machine : pas encore d'intervention planifiee -->
                <div class="alert alert-warning mb-0 py-2" role="alert"
                     invisible="type_demande not in ('reparation', 'remplacement') or statut_entretien == 'fait' or (date_planifiee and lot_id)">
                    Pour planifier : indiquez la <strong>Date prévue</strong> et le <strong>Numéro de série</strong>.
                    À l'enregistrement, l'intervention est créée toute seule (<strong>Planifiée</strong>).
                </div>
                <!-- Entretien : il faut aussi le technicien (la date prevue est deja mise par Odoo) -->
                <div class="alert alert-warning mb-0 py-2" role="alert"
                     invisible="type_demande != 'entretien' or statut_entretien == 'fait' or (date_planifiee and lot_id and user_id)">
                    Pour planifier l'entretien : indiquez le <strong>technicien</strong> (Assigné à), la
                    <strong>Date prévue</strong> et le <strong>Numéro de série</strong>. À l'enregistrement,
                    l'intervention d'entretien est créée toute seule (<strong>Planifiée</strong>).
                </div>
                <!-- Contrat du client : ce qui est couvert et ce qui se facture -->
                <field name="contrat_couverture" invisible="1"/>
                <div class="alert alert-success mb-0 py-2" role="status"
                     invisible="contrat_couverture != 'couvert' or type_demande not in ('reparation', 'entretien', 'remplacement')">
                    <field name="contrat_couverture_texte" readonly="1" class="d-inline"/>
                </div>
                <div class="alert alert-warning mb-0 py-2" role="status"
                     invisible="contrat_couverture != 'facture' or type_demande not in ('reparation', 'entretien', 'remplacement')">
                    <field name="contrat_couverture_texte" readonly="1" class="d-inline"/>
                </div>
                <!-- Machine a remplacer : impossible si le client n'a aucune machine -->
                <div class="alert alert-warning mb-0 py-2" role="alert"
                     invisible="type_demande != 'remplacement' or not partner_id or nb_machines_client">
                    Ce client a <strong>0 machine</strong> en inventaire : impossible de créer un ticket
                    « Machine à remplacer ». Choisissez un autre type ou vérifiez le client.
                </div>
                <!-- Ramassage demande a la main : Odoo cherche les machines louees chez le client -->
                <div class="alert alert-warning mb-0 py-2" role="alert"
                     invisible="type_demande != 'ramassage' or commande_reprise_id or not partner_id">
                    Aucune machine en location chez ce client : rien à ramasser.
                    Vérifiez le client (code client) ou le contrat de location.
                </div>
            </xpath>

            <!-- Un seul technicien : le champ natif « Assigné à », puis la date et le statut -->
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="date_planifiee" invisible="est_reprise"/>
                <field name="statut_entretien" widget="badge" invisible="not statut_entretien"
                       decoration-warning="statut_entretien == 'a_planifier'"
                       decoration-info="statut_entretien == 'planifie'"
                       decoration-success="statut_entretien == 'fait'"/>
            </xpath>

            <!-- Adresse commerciale : sa propre ligne, dans le groupe du telephone natif -->
            <xpath expr="//field[@name='partner_phone']/ancestor::group[1]" position="inside">
                <field name="adresse_commerce" string="Adresse commerciale" invisible="not adresse_commerce"/>
                <field name="contrat_client_id" readonly="1" invisible="not contrat_client_id"
                       groups="sales_team.group_sale_salesman"/>
                <field name="contrat_client_modele_id" readonly="1" invisible="not contrat_client_modele_id"
                       groups="sales_team.group_sale_salesman"/>
                <field name="contrat_client_type" readonly="1" invisible="not contrat_client_id"
                       groups="sales_team.group_sale_salesman"/>
                <field name="contrat_client_debut" readonly="1" invisible="not contrat_client_debut"
                       groups="sales_team.group_sale_salesman"/>
                <field name="contrat_client_fin" readonly="1" invisible="not contrat_client_fin"
                       groups="sales_team.group_sale_salesman"/>
            </xpath>

            <!-- Code client obligatoire : il remplit le client et ses machines -->
            <xpath expr="//field[@name='partner_id']" position="before">
                <field name="type_demande" required="1" placeholder="Réparation, entretien, ramassage…"/>
                <field name="type_reparation" widget="radio" invisible="type_demande != 'reparation'"
                       required="type_demande == 'reparation'"/>
                <field name="code_client" required="not est_entretien" placeholder="ex. MON134"
                       class="fw-bold"/>
            </xpath>

            <!-- 1. Identification du client  /  2. Parc machines du client -->
            <xpath expr="//field[@name='partner_id']/ancestor::group[last()]" position="after">
                <group name="dossier_client_machine" invisible="not commerce_id">
                    <!-- Client, telephone (natifs) et adresse : en haut, sans doublon -->
                    <group string="1. Identification du client" invisible="commercial_partner_id == commerce_id">
                        <field name="commerce_id" invisible="1"/>
                        <field name="commercial_partner_id" string="Nom de la bannière"/>
                    </group>
                    <group string="2. Parc machines du client">
                        <field name="machines_client_ids" invisible="1"/>
                        <field name="machines_choix_ids" invisible="1"/>
                        <field name="nb_machines_client"/>
                        <field name="machine_numero" invisible="not lot_id"/>
                        <field name="machine_modele_id" invisible="not lot_id"/>
                        <field name="machine_emplacement_id" invisible="not lot_id" options="{'no_open': True}"/>
                        <field name="lot_id" options="{'no_create': True}"
                               domain="[('id', 'in', machines_choix_ids)]"
                               placeholder="Choisir parmi les machines du client"/>
                        <field name="machine_dernier_entretien" invisible="not lot_id"/>
                        <field name="lot_remplacement_id" invisible="type_demande != 'remplacement'"
                               readonly="echange_livraison_id" options="{'no_create': True}"
                               placeholder="Machine en entrepôt, même modèle"/>
                        <field name="echange_retour_id" invisible="not echange_retour_id"/>
                        <field name="echange_livraison_id" invisible="not echange_livraison_id"/>
                        <field name="commande_reprise_id" invisible="not commande_reprise_id"/>
                        <field name="machines_reprise_ids" widget="many2many_tags" readonly="1"
                               invisible="not commande_reprise_id"/>
                        <field name="date_entretien_prevu" invisible="not est_entretien"/>
                        <field name="est_entretien" invisible="1"/>
                        <field name="nb_tickets_precedents" string="Historique des appels de service"/>
                    </group>
                </group>
            </xpath>

            <!-- Onglet natif « Description » renomme « Notes internes » -->
            <xpath expr="//page[.//field[@name='description']]" position="attributes">
                <attribute name="string">Notes internes</attribute>
            </xpath>

            <!-- Onglets d'historique, dans le carnet natif du ticket -->
            <xpath expr="//page[.//field[@name='description']]" position="after">
                    <page string="Historique d'intervention" name="interventions_machine"
                          invisible="not lot_id">
                        <field name="machine_intervention_ids" readonly="1">
                            <list create="false" edit="false" delete="false">
                                <field name="name"/>
                                <field name="date"/>
                                <field name="type" widget="badge"/>
                                <field name="description"/>
                                <field name="user_id" string="Technicien"/>
                                <field name="state" widget="badge"/>
                            </list>
                        </field>
                    </page>
                    <page string="Historique de la machine" name="historique_machine"
                          invisible="not lot_id">
                        <field name="machine_historique_ids" readonly="1">
                            <list create="false" edit="false" delete="false">
                                <field name="date"/>
                                <field name="type" widget="badge"/>
                                <field name="reference"/>
                                <field name="description"/>
                                <field name="partner_id"/>
                                <field name="user_id" optional="hide"/>
                                <field name="state"/>
                            </list>
                        </field>
                    </page>
                    <page string="Appels de service" name="appels_service" invisible="not commerce_id">
                        <field name="tickets_precedents_ids" readonly="1">
                            <list create="false" edit="false" delete="false">
                                <field name="create_date" string="Date"/>
                                <field name="name"/>
                                <field name="lot_id" string="Numéro de série"/>
                                <field name="tag_ids" widget="many2many_tags"/>
                                <field name="priority" widget="priority"/>
                                <field name="user_id"/>
                                <field name="stage_id"/>
                            </list>
                        </field>
                    </page>
                    <page string="Machines chez le client" name="machines_client" invisible="not commerce_id">
                        <field name="machines_client_ids" readonly="1">
                            <list create="false" edit="false" delete="false">
                                <field name="name" string="Numéro de série"/>
                                <field name="ref" string="Numéro de machine"/>
                                <field name="product_id" string="Modèle"/>
                                <field name="machine_statut" widget="badge"/>
                                <field name="date_installation"/>
                                <field name="date_dernier_entretien"/>
                                <field name="date_prochain_entretien"/>
                            </list>
                        </field>
                    </page>
            </xpath>
        </field>
    </record>

    <!-- Creation rapide (bouton + du kanban) : titre, type de ticket obligatoire, client, assigne -->
    <record id="helpdesk_ticket_view_form_creation_rapide" model="ir.ui.view">
        <field name="name">helpdesk.ticket.form.creation.rapide</field>
        <field name="model">helpdesk.ticket</field>
        <field name="mode">primary</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="name" string="Titre du ticket" placeholder="ex. Machine ne refroidit pas"/>
                    <field name="type_demande" required="1"/>
                    <field name="type_reparation" widget="radio" invisible="type_demande != 'reparation'"
                           required="type_demande == 'reparation'"/>
                    <field name="partner_id" string="Client" options="{'no_create': True}"/>
                    <field name="user_id" string="Assigné à" widget="many2one_avatar_user"/>
                    <field name="nb_machines_client" invisible="1"/>
                </group>
                <div class="alert alert-warning mb-0 py-1 small" role="alert"
                     invisible="type_demande != 'remplacement' or not partner_id or nb_machines_client">
                    Ce client a <strong>0 machine</strong> : impossible de faire « Machine à remplacer ».
                </div>
            </form>
        </field>
    </record>

    <!-- Kanban : petit badge « Technicien » sur chaque carte, a cote de l'avatar -->
    <record id="helpdesk_ticket_view_kanban_technicien" model="ir.ui.view">
        <field name="name">helpdesk.ticket.kanban.technicien</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_ticket_view_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="attributes">
                <attribute name="quick_create_view">suivi_machines_helpdesk.helpdesk_ticket_view_form_creation_rapide</attribute>
            </xpath>
            <!-- Champ declare en tete : toujours charge, quelle que soit la structure de la carte -->
            <xpath expr="//kanban" position="inside">
                <field name="technicien_id"/>
                <field name="type_demande"/>
            </xpath>
            <!-- Etiquette du type de ticket sous le titre : une couleur par type, lisible d'un coup d'oeil -->
            <xpath expr="(//templates//field[@name='name'])[1]" position="after">
                <div class="o_type_ticket my-1" invisible="not type_demande">
                    <field name="type_demande" widget="badge"
                           decoration-danger="type_demande == 'reparation'"
                           decoration-info="type_demande == 'entretien'"
                           decoration-warning="type_demande == 'remplacement'"
                           decoration-primary="type_demande == 'ramassage'"/>
                </div>
            </xpath>
            <!-- Dans la carte (templates), pas dans les declarations de champs en tete -->
            <xpath expr="(//templates//field[@name='user_id'])[1]" position="before">
                <field name="technicien_id" invisible="not technicien_id or technicien_id == user_id"
                       class="badge rounded-pill text-bg-info me-1 text-truncate" style="max-width: 160px;"/>
            </xpath>
        </field>
    </record>
</odoo>
