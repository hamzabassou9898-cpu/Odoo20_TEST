<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Ticket : technicien terrain (peut etre un technicien portail) -->
    <record id="view_ticket_form_technicien_terrain" model="ir.ui.view">
        <field name="name">helpdesk.ticket.form.assigne.technicien.portail</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_ticket_view_form"/>
        <field name="arch" type="xml">
            <!-- Un seul champ : « Assigne a » propose aussi les techniciens portail -->
            <xpath expr="//field[@name='user_id']" position="attributes">
                <attribute name="domain">['|', ('share', '=', False), ('partner_id.est_technicien', '=', True)]</attribute>
            </xpath>
        </field>
    </record>
</odoo>
