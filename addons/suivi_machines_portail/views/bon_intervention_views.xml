<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_bon_intervention" model="ir.sequence">
        <field name="name">Bon d'intervention</field>
        <field name="code">suivi.bon.intervention</field>
        <field name="prefix">BON/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- PDF du bon d'intervention signe -->
    <record id="action_rapport_bon_intervention" model="ir.actions.report">
        <field name="name">Bon d'intervention</field>
        <field name="model">suivi.bon.intervention</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">suivi_machines_portail.rapport_bon_intervention</field>
        <field name="print_report_name">'Bon %s' % object.name</field>
        <field name="binding_model_id" ref="model_suivi_bon_intervention"/>
        <field name="binding_type">report</field>
    </record>

    <template id="rapport_bon_intervention">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="bon">
                <t t-call="web.external_layout">
                    <div class="page" style="font-size: 13px;">
                        <div class="d-flex justify-content-between">
                            <h4 class="mb-0">Bon <span t-field="bon.name"/></h4>
                            <span class="text-muted">Rév. 01/26</span>
                        </div>
                        <table class="table table-sm mt-2 mb-2">
                            <tr><th style="width:25%">Client</th><td t-out="bon.partner_id.display_name"/></tr>
                            <tr t-if="bon.partner_id.contact_address"><th>Adresse</th><td t-out="bon.partner_id.contact_address"/></tr>
                            <tr><th>Équipements</th><td style="white-space: pre-line;" t-out="bon.equipements or (bon.lot_id and bon.lot_id.display_name) or '—'"/></tr>
                            <tr t-if="bon.travail"><th>Travail fait</th><td style="white-space: pre-line;" t-out="bon.travail"/></tr>
                        </table>

                        <!-- Section du formulaire papier, encadree comme l'original -->
                        <div style="border: 2px solid #000; padding: 12px;">
                            <div class="text-center mb-2">
                                <span style="border: 2px solid #000; padding: 3px 10px; font-weight: bold; text-transform: uppercase;"
                                      t-field="bon.type_bon"/>
                            </div>
                            <p style="text-align: justify;" t-out="bon.texte"/>
                            <t t-if="bon.type_bon == 'reprise'">
                                <p class="text-center" style="font-size: 14px;">
                                    <t t-foreach="[('tres_propre', 'TRÈS PROPRE'), ('moyen', 'MOYEN'), ('sale', 'SALE')]" t-as="choix">
                                        <span class="me-4"><t t-out="choix[1]"/> <t t-out="'☒' if bon.proprete == choix[0] else '☐'"/></span>
                                    </t><br/>
                                    <span class="me-4">PLEINE <t t-out="'☒' if bon.pleine else '☐'"/></span>
                                    <span>EN FONCTION <t t-out="'☒' if bon.en_fonction else '☐'"/></span>
                                </p>
                            </t>
                            <table style="width: 100%; margin-top: 18px;">
                                <tr>
                                    <td style="width: 34%; vertical-align: bottom; padding-right: 10px;">
                                        <img t-if="bon.signature" t-att-src="image_data_uri(bon.signature)" style="max-height: 2.5cm; max-width: 6cm;"/>
                                        <div style="border-top: 1px solid #000;" class="text-center">
                                            <t t-if="bon.type_bon == 'entretien'">SIGNATURE DU CLIENT</t>
                                            <t t-else="">SIGNATURE DU CLIENT OU DU COMMIS</t>
                                        </div>
                                    </td>
                                    <td style="width: 33%; vertical-align: bottom; padding-right: 10px;">
                                        <div class="text-center fw-bold" t-out="(bon.signe_par or '').upper()"/>
                                        <div style="border-top: 1px solid #000;" class="text-center">NOM EN LETTRES MOULÉES</div>
                                    </td>
                                    <td style="width: 33%; vertical-align: bottom;">
                                        <div class="text-center"><span t-field="bon.date" t-options="{'widget': 'date'}"/></div>
                                        <div style="border-top: 1px solid #000;" class="text-center">
                                            <t t-if="bon.type_bon == 'livraison'">DATE DE LIVRAISON</t>
                                            <t t-elif="bon.type_bon == 'reprise'">DATE DE REPRISE DES ÉQUIPEMENTS</t>
                                            <t t-else="">DATE DE L'ENTRETIEN</t>
                                        </div>
                                    </td>
                                </tr>
                            </table>
                            <div t-if="bon.type_bon == 'entretien'" style="margin-top: 14px; width: 34%;">
                                <div class="text-center" t-if="bon.signature_technicien">
                                    <img t-att-src="image_data_uri(bon.signature_technicien)" style="max-height: 60px;"/>
                                </div>
                                <div class="text-center fw-bold" t-out="bon.technicien_id.name"/>
                                <div style="border-top: 1px solid #000;" class="text-center">SIGNATURE DU TECHNICIEN</div>
                                <div t-if="not bon.signature_technicien" class="text-center text-muted" style="font-size: 10px;">Signature électronique (technicien connecté au portail)</div>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="view_bon_intervention_list" model="ir.ui.view">
        <field name="name">suivi.bon.intervention.list</field>
        <field name="model">suivi.bon.intervention</field>
        <field name="arch" type="xml">
            <list create="false" edit="false">
                <field name="date"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="type_bon"/>
                <field name="titre"/>
                <field name="lot_id" optional="show"/>
                <field name="technicien_id" widget="many2one_avatar_user"/>
                <field name="signe_par"/>
                <button name="action_telecharger" type="object" string="PDF" icon="download"/>
            </list>
        </field>
    </record>

    <record id="view_bon_intervention_form" model="ir.ui.view">
        <field name="name">suivi.bon.intervention.form</field>
        <field name="model">suivi.bon.intervention</field>
        <field name="arch" type="xml">
            <form create="false" edit="false">
                <header>
                    <button name="action_telecharger" type="object" string="Télécharger le PDF" class="btn-primary"/>
                </header>
                <sheet>
                    <h1><field name="name"/></h1>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="type_bon"/>
                            <field name="type_tache"/>
                            <field name="titre"/>
                            <field name="equipements"/>
                        </group>
                        <group>
                            <field name="technicien_id"/>
                            <field name="date"/>
                            <field name="signe_par"/>
                            <field name="ticket_id" invisible="not ticket_id"/>
                            <field name="picking_id" invisible="not picking_id"/>
                            <field name="intervention_id" invisible="not intervention_id"/>
                        </group>
                    </group>
                    <separator string="Engagement signé par le client"/>
                    <field name="texte" nolabel="1"/>
                    <group invisible="type_bon != 'reprise'">
                        <field name="proprete"/>
                        <field name="pleine"/>
                        <field name="en_fonction"/>
                    </group>
                    <separator string="Travail fait"/>
                    <field name="travail" nolabel="1"/>
                    <separator string="Signature du client"/>
                    <field name="signature" widget="image" nolabel="1" options="{'size': [0, 120]}"/>
                    <separator string="Signature du technicien" invisible="type_bon != 'entretien'"/>
                    <field name="signature_technicien" widget="image" nolabel="1" options="{'size': [0, 120]}"
                           invisible="type_bon != 'entretien'"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bons_intervention" model="ir.actions.act_window">
        <field name="name">Bons d'intervention signés</field>
        <field name="res_model">suivi.bon.intervention</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucun bon signé pour l'instant</p>
            <p>Le client signe sur le téléphone du technicien à la fin du travail (portail « Ma journée »).</p>
        </field>
    </record>

</odoo>
