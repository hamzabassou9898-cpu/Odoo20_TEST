<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Fil d'Ariane du portail -->
    <template id="portal_breadcrumbs_journee" inherit_id="portal.portal_breadcrumbs" priority="40">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'ma_journee'" class="breadcrumb-item active">Ma journée</li>
            <li t-if="page_name == 'ma_tache'" class="breadcrumb-item"><a t-att-href="retour">Ma journée</a></li>
            <li t-if="page_name == 'ma_tache'" class="breadcrumb-item active" t-out="tache.titre"/>
        </xpath>
    </template>

    <!-- Badges communs : type de tache et suivi -->
    <template id="portal_tache_badges">
        <span t-attf-class="badge rounded-pill text-bg-#{couleurs.get(tache.type_tache, 'secondary')}" t-field="tache.type_tache"/>
    </template>
    <template id="portal_tache_suivi">
        <span t-if="tache.etat_suivi == 'fait'" class="badge rounded-pill text-bg-success">Fait</span>
        <span t-elif="tache.etat_suivi == 'en_retard'" class="badge rounded-pill text-bg-danger">En retard</span>
    </template>

    <!-- ============================================================ Ma journee -->
    <template id="portal_ma_journee" name="Ma journée">
        <t t-call="portal.portal_layout">
            <style>.o_badge_neutre { color: #374151; background-color: #f3f4f6; border-color: #d1d5db !important; }</style>
            <div class="o_ma_journee mt-3 mx-auto" style="max-width: 720px;">
                <div class="d-flex justify-content-between align-items-center gap-2 mb-3">
                    <div>
                        <h3 class="mb-0">Ma journée</h3>
                        <div class="text-muted" t-out="titre_jour"/>
                    </div>
                    <div class="btn-group" role="group" aria-label="Jour">
                        <a t-attf-href="/my/journee?jour=#{veille}" class="btn btn-light border" title="Jour précédent">
                            <i class="oi" data-icon="chevron_left"/>
                        </a>
                        <a href="/my/journee" t-attf-class="btn border #{'btn-primary' if jour == aujourdhui else 'btn-light'}">Aujourd'hui</a>
                        <a t-attf-href="/my/journee?jour=#{lendemain}" class="btn btn-light border" title="Jour suivant">
                            <i class="oi" data-icon="chevron_right"/>
                        </a>
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-2 mb-3">
                    <span class="badge rounded-pill border o_badge_neutre fs-6 fw-normal">
                        <t t-out="len(taches)"/> tâche<t t-if="len(taches) &gt; 1">s</t>
                    </span>
                    <span t-if="nb_faites" class="badge rounded-pill text-bg-success fs-6 fw-normal">
                        <t t-out="nb_faites"/> faite<t t-if="nb_faites &gt; 1">s</t>
                    </span>
                    <span t-if="nb_retard" class="badge rounded-pill text-bg-danger fs-6 fw-normal">
                        <t t-out="nb_retard"/> en retard
                    </span>
                </div>


                <div t-if="not taches" class="alert alert-light border text-center my-4">
                    <i class="oi oi-2x d-block mb-2 text-muted" data-icon="coffee"/>Rien de prévu ce jour-là.
                </div>

                <div class="mt-3">
                    <t t-foreach="taches" t-as="tache">
                        <div t-attf-class="card mb-3 shadow-sm #{'opacity-50' if tache.etat_suivi == 'fait' else ''}">
                            <div t-attf-class="card-body border-start border-5 rounded border-#{couleurs.get(tache.type_tache, 'secondary')}">
                                <div class="d-flex justify-content-between align-items-start gap-2">
                                    <div class="fs-5 fw-bold d-flex align-items-center gap-2">
                                        <span t-attf-class="badge rounded-pill #{'text-bg-dark' if tache.heure_fixe else 'text-bg-secondary'}"
                                              t-att-title="'Heure fixe' if tache.heure_fixe else 'Ordre de la tournée'"
                                              t-out="pastilles.get(tache.id)"/>
                                        <span t-out="tache.date_affichage"/>
                                    </div>
                                    <t t-call="suivi_machines_portail.portal_tache_badges"/>
                                </div>
                                <div class="fw-bold text-uppercase mt-1" t-out="tache.partner_id.display_name"/>
                                <div t-if="tache.route" class="text-muted" t-out="tache.route"/>
                                <div class="mt-2" t-out="tache.titre"/>
                                <div t-if="tache.tag_ids" class="d-flex flex-wrap gap-1 mt-1">
                                    <span t-foreach="tache.tag_ids" t-as="tag" class="badge rounded-pill border o_badge_neutre" t-out="tag.name"/>
                                </div>
                                <div t-if="tache.machines"><span class="fw-bold">Machines : </span><t t-out="tache.machines"/></div>
                                <div t-if="tache.accessoires"><span class="fw-bold">Accessoires : </span><t t-out="tache.accessoires"/></div>
                                <div class="d-flex justify-content-between align-items-center mt-2">
                                    <a t-attf-href="/my/journee/tache/#{tache.id}" class="fw-bold">Détails <i class="oi" data-icon="chevron_right"/></a>
                                    <t t-call="suivi_machines_portail.portal_tache_suivi"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>
            </div>
        </t>
    </template>

    <!-- ============================================================ Detail d'une tache -->
    <template id="portal_ma_tache" name="Tâche du technicien">
        <t t-call="portal.portal_layout">
            <style>.o_badge_neutre { color: #374151; background-color: #f3f4f6; border-color: #d1d5db !important; }</style>
            <div class="mt-3 mx-auto" style="max-width: 720px;">
                <a t-att-href="retour" class="d-inline-block mb-2"><i class="oi me-1" data-icon="arrow_back"/>Ma journée</a>
                <div class="card shadow-sm">
                    <div t-attf-class="card-body border-start border-5 rounded border-#{couleurs.get(tache.type_tache, 'secondary')}">
                        <div class="d-flex justify-content-between align-items-start gap-2">
                            <div class="fs-4 fw-bold" t-out="tache.date_affichage"/>
                            <t t-call="suivi_machines_portail.portal_tache_badges"/>
                        </div>
                        <h4 class="mt-2 mb-1" t-out="tache.titre"/>
                        <div class="mb-2"><t t-call="suivi_machines_portail.portal_tache_suivi"/></div>

                        <h6 class="text-uppercase text-muted mt-3 mb-1">Client</h6>
                        <div class="fw-bold" t-out="tache.partner_id.display_name"/>
                        <div t-if="tache.route" t-out="tache.route"/>
                        <a t-if="telephone" t-attf-href="tel:#{telephone}" class="btn btn-sm btn-success text-white mt-2">
                            <i class="oi me-1" data-icon="phone"/>Appeler <t t-out="telephone"/>
                        </a>

                        <t t-if="tache.machines or tache.accessoires">
                            <h6 class="text-uppercase text-muted mt-3 mb-1">Matériel</h6>
                            <div t-if="tache.machines"><span class="fw-bold">Machines : </span><t t-out="tache.machines"/></div>
                            <div t-if="tache.accessoires"><span class="fw-bold">Accessoires : </span><t t-out="tache.accessoires"/></div>
                        </t>

                        <t t-if="tache.tag_ids">
                            <h6 class="text-uppercase text-muted mt-3 mb-1">Étiquettes</h6>
                            <span t-foreach="tache.tag_ids" t-as="tag" class="badge rounded-pill border o_badge_neutre me-1" t-out="tag.name"/>
                        </t>

                        <t t-if="ticket and ticket.type_reparation">
                            <h6 class="text-uppercase text-muted mt-3 mb-1">Type de réparation</h6>
                            <span class="badge rounded-pill text-bg-danger" t-field="ticket.type_reparation"/>
                        </t>

                        <t t-if="ticket and ticket.description">
                            <h6 class="text-uppercase text-muted mt-3 mb-1">Problème signalé</h6>
                            <div class="border rounded p-2 bg-light" t-field="ticket.description"/>
                        </t>

                        <t t-if="tache.reference">
                            <div class="text-muted small mt-3">Référence : <t t-out="tache.reference"/></div>
                        </t>
                    </div>
                </div>

                <!-- Note du technicien + pieces jointes : arrive dans le fil du document (note interne) -->
                <div class="card shadow-sm mt-3">
                    <div class="card-body">
                        <h5 class="mb-1">Ajouter une note</h5>
                        <div class="text-muted small mb-2">Ce qui a été fait, pièces changées, photos… La note s'ajoute au ticket et le bureau est prévenu.</div>
                        <div t-if="envoye" class="alert alert-success py-2" role="status">Note envoyée au bureau. Merci !</div>
                        <div t-if="erreur == 'vide'" class="alert alert-warning py-2" role="alert">Écrivez une note ou joignez un fichier.</div>
                        <div t-if="erreur == 'taille'" class="alert alert-danger py-2" role="alert">Un fichier dépasse 20 Mo : rien n'a été envoyé.</div>
                        <div t-if="erreur == 'nombre'" class="alert alert-danger py-2" role="alert">
                            <t t-out="max_fichiers"/> fichiers au plus par envoi : rien n'a été envoyé.
                        </div>
                        <form t-attf-action="/my/journee/tache/#{tache.id}/note" method="post" enctype="multipart/form-data">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <textarea name="note" class="form-control mb-2" rows="4"
                                      placeholder="ex. Machine nettoyée, joint de la vis remplacé, le client demande un rappel lundi."/>
                            <label class="form-label small text-muted mb-1" for="pieces_jointes">Photos et documents (20 Mo max. par fichier)</label>
                            <input type="file" id="pieces_jointes" name="pieces_jointes" multiple="multiple" class="form-control mb-3"
                                   accept="image/*,application/pdf,.doc,.docx,.xls,.xlsx,.txt,.csv,.heic"/>
                            <button type="submit" class="btn btn-primary w-100">
                                <i class="oi me-1" data-icon="send"/>Envoyer au bureau
                            </button>
                        </form>
                    </div>
                </div>

                <!-- Fin du travail : le client signe sur le telephone, le bon PDF part au bureau -->
                <div class="card shadow-sm mt-3" id="bon_intervention">
                    <div class="card-body">
                        <h5 class="mb-1">Terminer : signature du client</h5>
                        <div class="text-uppercase fw-bold small border border-dark d-inline-block px-2 py-1 my-2"
                             t-out="titre_bon + (' (ramassage)' if type_bon == 'reprise' else '')"/>
                        <t t-if="bon">
                            <div class="alert alert-success py-2 mb-2" role="status">
                                <i class="oi me-1" data-icon="check"/>Bon <strong t-out="bon.name"/> signé par
                                <strong t-out="bon.signe_par"/>. Le bureau l'a reçu.
                            </div>
                            <!-- Ce qui est sur le bon : date, signature du client, signature du technicien -->
                            <div class="row g-3 mb-3">
                                <div class="col-12">
                                    <div class="small text-muted text-uppercase">
                                        <t t-if="bon.type_bon == 'livraison'">Date de livraison</t>
                                        <t t-elif="bon.type_bon == 'reprise'">Date de reprise des équipements</t>
                                        <t t-else="">Date de l'entretien</t>
                                    </div>
                                    <div class="fw-bold" t-field="bon.date" t-options="{'widget': 'date'}"/>
                                </div>
                                <div class="col-12" t-if="bon.type_bon == 'reprise'">
                                    <div class="small text-muted" t-out="bon.texte"/>
                                    <div class="d-flex flex-wrap gap-3 fw-bold small text-uppercase">
                                        <span t-foreach="proprietes" t-as="p"><t t-out="p[1]"/> <t t-out="'☒' if bon.proprete == p[0] else '☐'"/></span>
                                        <span>Pleine <t t-out="'☒' if bon.pleine else '☐'"/></span>
                                        <span>En fonction <t t-out="'☒' if bon.en_fonction else '☐'"/></span>
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="small text-muted text-uppercase">Signature du client</div>
                                    <img t-if="bon.signature" t-att-src="image_data_uri(bon.signature)" alt="Signature du client"
                                         class="img-fluid border rounded bg-white p-1" style="max-height: 110px;"/>
                                    <div class="small" t-out="bon.signe_par"/>
                                </div>
                                <div class="col-sm-6" t-if="bon.type_bon == 'entretien'">
                                    <div class="small text-muted text-uppercase">Signature du technicien</div>
                                    <t t-if="bon.signature_technicien">
                                        <img t-att-src="image_data_uri(bon.signature_technicien)" alt="Signature du technicien"
                                             class="img-fluid border rounded bg-white p-1" style="max-height: 110px;"/>
                                        <div class="small" t-out="bon.technicien_id.name"/>
                                    </t>
                                    <div t-else="" class="text-warning small">À signer ci-dessous.</div>
                                </div>
                            </div>
                            <!-- Le technicien signe a son tour (entretien / reparation) -->
                            <div t-if="bon.doit_signer_technicien" class="border rounded p-2 mb-3">
                                <div class="fw-bold mb-1">Signature du technicien</div>
                                <t t-call="portal.signature_form"
                                   call_url="'/my/journee/tache/%s/signer_technicien' % tache.id"
                                   default_name="bon.technicien_id.name or ''"
                                   mode="'draw'"
                                   send_label="'Signer le bon (technicien)'"/>
                            </div>
                            <a t-if="bon.pdf_id" t-attf-href="/my/journee/tache/#{tache.id}/bon" class="btn btn-outline-primary w-100">
                                <i class="oi me-1" data-icon="download"/>Voir le bon (PDF)
                            </a>
                        </t>
                        <t t-elif="tache.a_faire">
                            <div class="text-muted small mb-2">Écrivez d'abord ce qui a été fait (note ci-dessus), puis faites signer
                                le client : le bon est envoyé au bureau et la tâche est terminée.</div>
                            <!-- Ce que le client signe (texte du formulaire papier) -->
                            <div class="border rounded p-2 bg-light small mb-2">
                                <div t-if="tache.machines or tache.accessoires" class="mb-1">
                                    <strong>Équipements :</strong>
                                    <t t-out="tache.machines"/><t t-if="tache.machines and tache.accessoires"> · </t><t t-out="tache.accessoires"/>
                                </div>
                                <div t-out="texte_bon"/>
                            </div>
                            <!-- Reprise : cases a cocher avant la signature -->
                            <form t-if="reprise" t-attf-action="/my/journee/tache/#{tache.id}/reprise" method="post" class="mb-3">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <div class="d-flex flex-wrap gap-3 mb-2">
                                    <label t-foreach="proprietes" t-as="p" class="form-check">
                                        <input type="radio" name="proprete" class="form-check-input" required="required"
                                               t-att-value="p[0]" t-att-checked="reprise.reprise_proprete == p[0]"/>
                                        <span class="form-check-label text-uppercase" t-out="p[1]"/>
                                    </label>
                                </div>
                                <div class="d-flex flex-wrap gap-3 mb-2">
                                    <label class="form-check"><input type="checkbox" name="pleine" value="1" class="form-check-input"
                                        t-att-checked="reprise.reprise_pleine"/><span class="form-check-label">PLEINE</span></label>
                                    <label class="form-check"><input type="checkbox" name="en_fonction" value="1" class="form-check-input"
                                        t-att-checked="reprise.reprise_en_fonction"/><span class="form-check-label">EN FONCTION</span></label>
                                </div>
                                <button type="submit" class="btn btn-outline-primary w-100">Enregistrer l'état</button>
                            </form>
                            <div t-if="not peut_signer" class="alert alert-warning py-2 small">Cochez d'abord l'état des équipements.</div>
                            <t t-if="peut_signer" t-call="portal.signature_form"
                               call_url="'/my/journee/tache/%s/signer' % tache.id"
                               default_name="tache.partner_id.name or ''"
                               mode="'draw'"
                               send_label="'Terminer et envoyer le bon'"/>
                        </t>
                        <div t-else="" class="text-muted small">Tâche déjà terminée.</div>
                    </div>
                </div>

                <div t-if="mes_notes" class="card shadow-sm mt-3">
                    <div class="card-body">
                        <h6 class="text-uppercase text-muted mb-2">Mes notes envoyées</h6>
                        <div t-foreach="mes_notes" t-as="msg" class="border-start border-3 ps-2 mb-3">
                            <div class="small text-muted" t-out="msg.date" t-options="{'widget': 'datetime'}"/>
                            <div t-if="msg.note" style="white-space: pre-line;" t-out="msg.note"/>
                            <div t-if="msg.attachment_ids" class="small mt-1">
                                <span t-foreach="msg.attachment_ids" t-as="pj" class="badge rounded-pill border o_badge_neutre me-1">
                                    <i class="oi me-1" data-icon="attach_file"/><t t-out="pj.name"/>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
