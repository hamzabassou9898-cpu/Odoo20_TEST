<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Services de base pour les frais d'intervention (prix modifiables dans Ventes > Produits) -->
    <record id="produit_frais_deplacement" model="product.product">
        <field name="name">Frais de déplacement</field>
        <field name="type">service</field>
        <field name="default_code">FRAIS-DEPL</field>
        <field name="list_price">0</field>
    </record>
    <record id="produit_frais_reparation" model="product.product">
        <field name="name">Main-d'œuvre réparation</field>
        <field name="type">service</field>
        <field name="default_code">FRAIS-REP</field>
        <field name="list_price">0</field>
    </record>
    <record id="produit_frais_livraison" model="product.product">
        <field name="name">Frais de livraison / reprise</field>
        <field name="type">service</field>
        <field name="default_code">FRAIS-LIV</field>
        <field name="list_price">0</field>
    </record>
</odoo>
