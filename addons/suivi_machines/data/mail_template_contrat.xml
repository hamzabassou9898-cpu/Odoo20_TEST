<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Courriel « Envoyer » d'un contrat de location (pas encore signé) : en français, avec le bouton du
         lien sécurisé du client dans le texte (visible aussi dans la fenêtre d'envoi) -->
    <record id="mail_template_contrat_location" model="mail.template">
        <field name="name">Monroy : contrat de location à signer</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="subject">{{ object.company_id.name }} – Votre contrat de location {{ object.name }} à signer</field>
        <field name="email_from">{{ (object.user_id.email_formatted or object.company_id.email_formatted or user.email_formatted) }}</field>
        <field name="use_default_to" eval="True"/>
        <field name="description">Envoyé au client pour lire, compléter et signer son contrat de location en ligne</field>
        <field name="email_layout_xmlid" eval="False"/>
        <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px; font-size: 14px; line-height: 1.5;">
    <p style="margin: 0px 0px 16px 0px;">
        <img t-att-src="'%s/logo.png?company=%s' % (object.get_base_url(), object.company_id.id)" style="max-height: 60px;" alt="Logo"/>
    </p>
    <p style="margin: 0px;">
        Bonjour <t t-out="object.partner_id.name or ''">client</t>,
        <br/><br/>
        Voici votre contrat de location <strong t-out="object.name or ''">LOC00001</strong>
        <t t-if="object.type_contrat_id">(<t t-out="object.type_contrat_id.name or ''">Convention slush</t>)</t>,
        avec votre soumission de <strong t-out="format_amount(object.amount_total, object.currency_id) or ''">0,00 $</strong>.
        <br/><br/>
        Cliquez sur le bouton ci-dessous pour lire le contrat, remplir vos informations (initiales, compagnie,
        caution) et le signer en ligne. Vous pourrez ensuite télécharger votre copie signée.
    </p>
    <p style="margin: 24px 0px;">
        <a t-att-href="object.get_base_url() + object.get_portal_url()"
           style="background-color: #2f6fd1; padding: 12px 22px; text-decoration: none; color: #ffffff; border-radius: 6px; font-weight: bold; font-size: 15px;">
            Lire et signer mon contrat
        </a>
    </p>
    <p style="margin: 0px;">
        Une question ? Répondez simplement à ce courriel.
        <br/><br/>
        Merci de votre confiance,
        <br/>
        <t t-out="user.name or object.company_id.name or ''">Jose</t>
        <br/>
        <t t-out="object.company_id.name or ''">Monroy Inc</t>
        <t t-if="object.company_id.phone"> · <t t-out="object.company_id.phone or ''"/></t>
    </p>
</div>
        </field>
        <field name="report_template_ids" eval="[(4, ref('sale.action_report_saleorder'))]"/>
        <field name="auto_delete" eval="True"/>
    </record>
</odoo>
