<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Livraison : livreur + n° de serie de chaque machine qui sort du stock -->
    <record id="view_picking_form_machine" model="ir.ui.view">
        <field name="name">stock.picking.form.machine</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <field name="origin" position="before">
                <field name="livreur_id" widget="many2one_avatar_user"
                       readonly="state in ('done', 'cancel')"/>
            </field>
            <xpath expr="//field[@name='move_ids']/list/column[field[@name='product_id']]" position="after">
                <field name="est_machine" column_invisible="1"/>
                <field name="machine_lot_id" string="N° de série (machine)"
                       invisible="not est_machine" readonly="state in ('done', 'cancel')"
                       options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>

    <record id="view_picking_list_machine" model="ir.ui.view">
        <field name="name">stock.picking.list.machine</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="livreur_id" optional="show" widget="many2one_avatar_user"/>
            </field>
        </field>
    </record>

    <record id="view_picking_search_machine" model="ir.ui.view">
        <field name="name">stock.picking.search.machine</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_internal_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="livreur_id"/>
                <filter name="grp_livreur" string="Livreur" context="{'group_by': 'livreur_id'}"/>
            </xpath>
        </field>
    </record>
</odoo>
