<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Livraison : livreur + n° de serie de chaque machine qui sort du stock -->
    <record id="view_picking_form_machine" model="ir.ui.view">
        <field name="name">stock.picking.form.machine</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="picking_type_code" invisible="1"/>
                <button name="action_planifier_ramassage" type="object" string="Planifier le ramassage"
                        class="btn-primary" invisible="state != 'done' or picking_type_code != 'outgoing'"
                        help="Créer le bon de retour des machines (et accessoires) de cette livraison"/>
            </xpath>
            <!-- Fiche de machine en haut, des que le n° de serie est choisi -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_fiche_machines" type="object" class="oe_stat_button"
                        icon="precision_manufacturing" invisible="not machine_fiche_count">
                    <div class="o_stat_info">
                        <span class="o_stat_value"><field name="machine_fiche_label"/></span>
                        <span class="o_stat_text">Fiche de machine</span>
                    </div>
                    <field name="machine_fiche_count" invisible="1"/>
                </button>
            </xpath>
            <!-- Livraison / ramassage : pas de validation sans technicien (bandeau rouge) -->
            <xpath expr="//sheet" position="before">
                <field name="technicien_requis" invisible="1"/>
                <field name="livre_machines" invisible="1"/>
                <field name="echange_picking_id" invisible="1"/>
                <div class="alert alert-info mb-0 py-2" role="status" invisible="not echange_picking_id">
                    <strong>Échange de machine</strong> avec <field name="echange_picking_id" class="d-inline"
                    readonly="1"/> : valider ce transfert valide aussi l'autre (une seule opération).
                </div>
                <div class="alert alert-danger mb-0 py-2" role="alert"
                     invisible="not livre_machines or state in ('done', 'cancel') or (prochain_entretien and frequence_entretien)">
                    Indiquez le <strong>Prochain entretien</strong> et la <strong>Fréquence des entretiens</strong> des
                    machines livrées : Odoo les garde sur la fiche de chaque machine et prévient le bureau un mois avant.
                </div>
                <div class="alert alert-danger mb-0 py-2" role="alert" invisible="not technicien_requis or livreur_id">
                    Choisissez le <strong>Technicien assigné</strong> : il est obligatoire pour valider cette
                    livraison ou ce ramassage.
                </div>
            </xpath>
            <field name="origin" position="before">
                <field name="livreur_id" widget="many2one_avatar_user"
                       readonly="state in ('done', 'cancel')"/>
                <field name="prochain_entretien" invisible="not livre_machines"
                       readonly="state in ('done', 'cancel')"/>
                <field name="frequence_entretien" invisible="not livre_machines"
                       readonly="state in ('done', 'cancel')"/>
            </field>
            <xpath expr="//field[@name='move_ids']/list/column[field[@name='product_id']]" position="after">
                <field name="est_machine" column_invisible="1"/>
                <field name="machine_lot_id" string="N° de série (machine)"
                       invisible="not est_machine" readonly="state in ('done', 'cancel')"
                       options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>

    <record id="view_picking_list_machine" model="ir.ui.view">
        <field name="name">stock.picking.list.machine</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="livreur_id" optional="show" widget="many2one_avatar_user"/>
            </field>
        </field>
    </record>

    <record id="view_picking_search_machine" model="ir.ui.view">
        <field name="name">stock.picking.search.machine</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_internal_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="livreur_id"/>
                <filter name="grp_livreur" string="Technicien" context="{'group_by': 'livreur_id'}"/>
            </xpath>
        </field>
    </record>

    <record id="view_planifier_ramassage_form" model="ir.ui.view">
        <field name="name">suivi.machines.planifier.ramassage.form</field>
        <field name="model">suivi.machines.planifier.ramassage</field>
        <field name="arch" type="xml">
            <form string="Planifier le ramassage">
                <group>
                    <group>
                        <field name="picking_id"/>
                        <field name="partner_id"/>
                    </group>
                    <group>
                        <field name="date"/>
                        <field name="livreur_id" widget="many2one_avatar_user" options="{'no_create': True}"/>
                    </group>
                </group>
                <field name="machines_livrees_ids" invisible="1"/>
                <separator string="Machines à reprendre"/>
                <field name="lot_ids" widget="many2many_checkboxes" nolabel="1"/>
                <group invisible="not accessoires">
                    <field name="avec_accessoires"/>
                    <field name="accessoires" readonly="1"/>
                </group>
                <footer>
                    <button name="action_planifier" type="object" string="Créer le bon de retour" class="btn-primary"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
