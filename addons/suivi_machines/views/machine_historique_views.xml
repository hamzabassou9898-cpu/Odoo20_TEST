<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_historique_list" model="ir.ui.view">
        <field name="name">machine.historique.list</field>
        <field name="model">machine.historique</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false"
                  decoration-danger="type == 'bris'" decoration-info="type == 'mouvement'"
                  decoration-muted="state == 'Annulée'">
                <field name="date"/>
                <field name="lot_id"/>
                <field name="product_id" optional="show"/>
                <field name="type"/>
                <field name="reference"/>
                <field name="description"/>
                <field name="partner_id"/>
                <field name="user_id" optional="hide"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_historique_search" model="ir.ui.view">
        <field name="name">machine.historique.search</field>
        <field name="model">machine.historique</field>
        <field name="arch" type="xml">
            <search>
                <field name="lot_id"/>
                <field name="product_id"/>
                <field name="partner_id"/>
                <filter name="mouvements" string="Mouvements d'inventaire" domain="[('type', '=', 'mouvement')]"/>
                <filter name="interventions" string="Interventions" domain="[('type', '!=', 'mouvement')]"/>
                <filter name="bris" string="Bris" domain="[('type', '=', 'bris')]"/>
                <filter name="date" string="Date" date="date"/>
                <group>
                    <filter name="grp_lot" string="Machine" context="{'group_by': 'lot_id'}"/>
                    <filter name="grp_type" string="Type" context="{'group_by': 'type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_historique" model="ir.actions.act_window">
        <field name="name">Historique des machines</field>
        <field name="res_model">machine.historique</field>
        <field name="view_mode">list</field>
        <field name="domain">[('lot_id.est_machine', '=', True)]</field>
    </record>
</odoo>
