<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_type_contrat_list" model="ir.ui.view">
        <field name="name">suivi.type.contrat.list</field>
        <field name="model">suivi.type.contrat</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="type_commande"/>
                <field name="forfait_montant"/>
                <field name="couvre_reparations"/>
                <field name="frais_appel_inutile"/>
                <field name="frais_deplacement"/>
                <field name="taux_horaire"/>
                <field name="clause_penale"/>
                <field name="modele" optional="hide"/>
                <field name="forfait_produit_id" optional="hide"/>
                <field name="note" optional="show"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="action_types_contrat" model="ir.actions.act_window">
        <field name="name">Types de contrat</field>
        <field name="res_model">suivi.type.contrat</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_types_contrat" name="Types de contrat" parent="sale.menu_sale_config"
              action="action_types_contrat" sequence="30"/>

    <!-- Contrat : type de contrat et forfait annuel -->
    <record id="view_order_form_type_contrat" model="ir.ui.view">
        <field name="name">sale.order.form.type.contrat</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="suivi_machines.view_order_form_machine_lot"/>
        <field name="arch" type="xml">
            <field name="type_commande" position="before">
                <field name="type_contrat_id" options="{'no_create': True}" placeholder="Location, convention…"/>
            </field>
            <field name="type_commande" position="attributes">
                <attribute name="readonly">type_contrat_id</attribute>
            </field>
            <field name="date_fin_location" position="after">
                <field name="forfait_montant" invisible="not type_contrat_id"
                       readonly="state not in ('draft', 'sent')"/>
                <field name="forfait_prochaine_date" invisible="not forfait_montant or state != 'sale'"/>
                <field name="contrat_modele" invisible="1"/>
                <!-- Contrat original : saison et prix de detail des que c'est une location (avant meme le
                     choix du type de contrat) -->
                <field name="saison" invisible="not type_contrat_id and type_commande != 'location'"/>
                <label for="prix_detail_353" string="Prix de détail (353 / 510 / 775 ml)"
                       invisible="(not type_contrat_id and type_commande != 'location') or contrat_modele == 'popcorn'"/>
                <div class="d-flex gap-2"
                     invisible="(not type_contrat_id and type_commande != 'location') or contrat_modele == 'popcorn'">
                    <field name="prix_detail_353" class="oe_inline"/>
                    <field name="prix_detail_510" class="oe_inline"/>
                    <field name="prix_detail_775" class="oe_inline"/>
                </div>
            </field>
            <xpath expr="//header" position="inside">
                <field name="forfait_a_renouveler" invisible="1"/>
                <button name="action_renouveler_forfait" type="object" string="Renouveler le forfait"
                        class="btn-primary" invisible="not forfait_a_renouveler or state != 'sale'"
                        help="Ajuster le prix et ajouter le forfait de l'année au contrat"/>
            </xpath>
            <xpath expr="//sheet" position="before">
                <div class="alert alert-warning mb-0 py-2" role="alert"
                     invisible="not forfait_a_renouveler or state != 'sale'">
                    <strong>Forfait annuel à renouveler</strong> : ajustez le prix avec le bouton
                    « Renouveler le forfait ».
                </div>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Contrat (client)" name="contrat_client" invisible="not type_contrat_id">
                    <p class="text-muted">Rempli par le client sur sa page (lien du devis) avant de signer ; modifiable ici.</p>
                    <group>
                        <group string="Client">
                            <field name="contrat_initiales"/>
                            <field name="contrat_compagnie" widget="radio" options="{'horizontal': true}"/>
                            <field name="proprietaire_immeuble"/>
                        </group>
                        <group string="Caution (compagnie)" invisible="contrat_compagnie != 'oui'">
                            <field name="caution_nom"/>
                            <field name="caution_numero"/>
                            <field name="caution_rue"/>
                            <field name="caution_ville"/>
                            <field name="caution_province"/>

                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Menu Action d'une vente / location : refaire le PDF dans le profil du client -->
    <record id="action_serveur_ranger_pdf_client" model="ir.actions.server">
        <field name="name">Ranger le PDF dans le profil du client</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_view_types">list,form</field>
        <field name="group_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="state">code</field>
        <field name="code">action = records.action_ranger_pdf_client()</field>
    </record>

    <record id="view_forfait_renouvellement_form" model="ir.ui.view">
        <field name="name">suivi.forfait.renouvellement.form</field>
        <field name="model">suivi.forfait.renouvellement</field>
        <field name="arch" type="xml">
            <form string="Renouveler le forfait">
                <group>
                    <group>
                        <field name="order_id" force_save="1"/>
                        <field name="partner_id"/>
                        <field name="date_debut"/>
                    </group>
                    <group>
                        <field name="prix_precedent" force_save="1"/>
                        <field name="prix"/>
                        <field name="nombre"/>
                    </group>
                </group>
                <footer>
                    <button name="action_renouveler" type="object" string="Renouveler" class="btn-primary"/>
                    <button string="Annuler" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
