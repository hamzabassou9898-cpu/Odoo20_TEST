<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_type_contrat_list" model="ir.ui.view">
        <field name="name">suivi.type.contrat.list</field>
        <field name="model">suivi.type.contrat</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="type_commande"/>
                <field name="forfait_montant"/>
                <field name="couvre_reparations"/>
                <field name="frais_appel_inutile"/>
                <field name="frais_deplacement"/>
                <field name="taux_horaire"/>
                <field name="clause_penale"/>
                <field name="modele" optional="hide"/>
                <field name="forfait_produit_id" optional="hide"/>
                <field name="note" optional="show"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="action_types_contrat" model="ir.actions.act_window">
        <field name="name">Types de contrat</field>
        <field name="res_model">suivi.type.contrat</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_types_contrat" name="Types de contrat" parent="sale.menu_sale_config"
              action="action_types_contrat" sequence="30"/>

    <!-- Contrat : type de contrat et forfait annuel -->
    <record id="view_order_form_type_contrat" model="ir.ui.view">
        <field name="name">sale.order.form.type.contrat</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="suivi_machines.view_order_form_machine_lot"/>
        <field name="arch" type="xml">
            <field name="type_commande" position="before">
                <field name="type_contrat_id" options="{'no_create': True}" placeholder="Location, convention…"/>
            </field>
            <field name="type_commande" position="attributes">
                <attribute name="readonly">type_contrat_id</attribute>
            </field>
            <field name="date_fin_location" position="after">
                <field name="forfait_montant" invisible="not type_contrat_id"
                       readonly="state not in ('draft', 'sent')"/>
                <field name="forfait_prochaine_date" invisible="not forfait_montant or state != 'sale'"/>
                <field name="contrat_modele" invisible="1"/>
                <field name="saison" invisible="not type_contrat_id"/>
                <label for="prix_detail_353" string="Prix de détail (353 / 510 / 775 ml)"
                       invisible="not type_contrat_id or contrat_modele == 'popcorn'"/>
                <div class="d-flex gap-2" invisible="not type_contrat_id or contrat_modele == 'popcorn'">
                    <field name="prix_detail_353" class="oe_inline"/>
                    <field name="prix_detail_510" class="oe_inline"/>
                    <field name="prix_detail_775" class="oe_inline"/>
                </div>
            </field>
        </field>
    </record>
</odoo>
