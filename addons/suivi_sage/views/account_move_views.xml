<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Facture / avoir (client et fournisseur) : boutons et informations Sage -->
    <record id="view_move_form_sage" model="ir.ui.view">
        <field name="name">account.move.form.sage</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_transfere_sage" type="object" string="Enregistré dans Sage"
                        invisible="statut_sage != 'a_transferer'" groups="account.group_account_invoice"/>
                <button name="action_annuler_transfert_sage" type="object" string="Annuler le transfert Sage"
                        invisible="not sage_transfere" groups="account.group_account_manager"/>
            </xpath>
            <xpath expr="//sheet" position="before">
                <div class="alert alert-warning mb-0 py-2" role="alert" invisible="statut_sage != 'a_transferer'">
                    Cette pièce n'est pas encore enregistrée dans <strong>Sage</strong>.
                </div>
                <div class="alert alert-success mb-0 py-2" role="alert" invisible="statut_sage != 'transfere'">
                    Enregistrée dans <strong>Sage</strong>
                    <span invisible="not sage_date"> le <field name="sage_date" readonly="1" class="d-inline"/></span>
                    <span invisible="not sage_reference"> (pièce <field name="sage_reference" readonly="1" class="d-inline"/>)</span>.
                </div>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Sage" name="sage" invisible="move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund')">
                    <group>
                        <group>
                            <field name="statut_sage" widget="badge"
                                   decoration-warning="statut_sage == 'a_transferer'"
                                   decoration-success="statut_sage == 'transfere'"/>
                            <field name="sage_transfere"/>
                        </group>
                        <group>
                            <field name="sage_date"/>
                            <field name="sage_reference" placeholder="n° de la pièce dans Sage"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Listes : colonne Statut Sage (factures clients, fournisseurs, avoirs) -->
    <record id="view_invoice_tree_sage" model="ir.ui.view">
        <field name="name">account.move.list.sage</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <!-- Case a cocher directement dans la liste (enregistre aussitot) -->
                <field name="sage_transfere" string="Enregistré dans Sage" widget="boolean_toggle"
                       optional="show" readonly="state != 'posted'"/>
                <field name="statut_sage" string="Statut Sage" widget="badge" optional="hide"
                       decoration-warning="statut_sage == 'a_transferer'"
                       decoration-success="statut_sage == 'transfere'"/>
                <field name="sage_date" optional="hide"/>
                <field name="sage_reference" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_invoice_filter_sage" model="ir.ui.view">
        <field name="name">account.move.search.sage</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="sage_reference"/>
                <separator/>
                <filter name="sage_a_transferer" string="À enregistrer dans Sage"
                        domain="[('statut_sage', '=', 'a_transferer')]"/>
                <filter name="sage_transfere" string="Enregistré dans Sage"
                        domain="[('statut_sage', '=', 'transfere')]"/>
                <filter name="grp_statut_sage" string="Statut Sage" context="{'group_by': 'statut_sage'}"/>
            </xpath>
        </field>
    </record>

    <!-- Action de groupe (liste > Actions) -->
    <record id="action_server_transfere_sage" model="ir.actions.server">
        <field name="name">Marquer enregistré dans Sage</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">records.action_transfere_sage()</field>
        <field name="group_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
    </record>

    <!-- Menus Facturation > Clients / Fournisseurs : a transferer dans Sage -->
    <record id="action_sage_clients" model="ir.actions.act_window">
        <field name="name">Clients : à enregistrer dans Sage</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('move_type', 'in', ('out_invoice', 'out_refund'))]</field>
        <field name="context">{'search_default_sage_a_transferer': 1, 'default_move_type': 'out_invoice'}</field>
        <field name="view_id" ref="account.view_out_invoice_tree"/>
        <field name="search_view_id" ref="account.view_account_invoice_filter"/>
    </record>
    <record id="action_sage_fournisseurs" model="ir.actions.act_window">
        <field name="name">Fournisseurs : à enregistrer dans Sage</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('move_type', 'in', ('in_invoice', 'in_refund'))]</field>
        <field name="context">{'search_default_sage_a_transferer': 1, 'default_move_type': 'in_invoice'}</field>
        <field name="view_id" ref="account.view_in_invoice_tree"/>
        <field name="search_view_id" ref="account.view_account_invoice_filter"/>
    </record>
    <menuitem id="menu_sage_clients" name="À enregistrer dans Sage" parent="account.menu_finance_receivables"
              action="action_sage_clients" sequence="3"/>
    <menuitem id="menu_sage_fournisseurs" name="À enregistrer dans Sage" parent="account.menu_finance_payables"
              action="action_sage_fournisseurs" sequence="3"/>
</odoo>
