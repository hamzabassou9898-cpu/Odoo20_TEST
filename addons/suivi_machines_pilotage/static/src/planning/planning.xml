<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <div t-name="suivi_machines_pilotage.GraphiquePlanning" class="o_pp_graph"><canvas t-ref="this.chart.ref"/></div>

    <div t-name="suivi_machines_pilotage.PlanningSemaine" t-translation="off" t-attf-class="o_action o_pilotage_planning {{ this.state.chargement ? 'o_pp_charge' : '' }}">
        <t t-set="d" t-value="this.state.donnees"/>
        <div t-if="this.state.bord" t-attf-class="o_pp_bord o_pp_bord_{{ this.state.bord }}">
            <t t-if="this.state.bord === 'suivante'">Suivant ›</t><t t-else="">‹ Précédent</t>
        </div>
        <div class="o_content o_pp_defile">
        <div class="o_pp_wrap" t-if="d">
            <t t-set="k" t-value="d.indicateurs"/>
            <t t-set="g" t-value="d.graphiques"/>
            <div class="o_pp_head">
                <div>
                    <h1>Planning</h1>
                    <p t-if="d.peut_deplacer">Glissez une tâche sur un technicien ou un autre jour : le ticket, le transfert ou l'intervention est mis à jour.</p>
                </div>
                <div class="o_pp_nav">
                    <button class="o_pp_btn" t-on-click="() => this.charger(d.precedente)" title="Précédent">‹</button>
                    <button class="o_pp_btn" t-on-click="() => this.charger()"
                            t-out="d.periode === 'jour' ? 'Aujourd’hui' : d.periode === 'mois' ? 'Ce mois' : 'Cette semaine'"/>
                    <button class="o_pp_btn" t-on-click="() => this.charger(d.suivante)" title="Suivant">›</button>
                    <span class="o_pp_titre" t-out="d.titre"/>
                </div>
            </div>
            <div class="o_pp_outils">
                <select class="o_pp_btn o_pp_select" t-on-change="(ev) => this.filtrer('technicien_id', ev)">
                    <option value="0" t-att-selected="!d.filtres.technicien_id">👤 Tous les techniciens</option>
                    <option t-foreach="d.filtres.techniciens" t-as="tech" t-key="tech.id" t-att-value="tech.id"
                            t-att-selected="d.filtres.technicien_id === tech.id" t-out="tech.nom"/>
                    <option value="-1" t-att-selected="d.filtres.technicien_id === -1">Sans technicien</option>
                </select>
                <select class="o_pp_btn o_pp_select" t-on-change="(ev) => this.filtrer('type_tache', ev)">
                    <option value="" t-att-selected="!d.filtres.type_tache">🏷️ Tous les types</option>
                    <option t-foreach="d.filtres.types" t-as="ty" t-key="ty.code" t-att-value="ty.code"
                            t-att-selected="d.filtres.type_tache === ty.code" t-out="ty.nom"/>
                </select>
                <span class="o_pp_groupe">
                    <button t-attf-class="o_pp_btn {{ d.periode === 'jour' ? 'o_pp_actif' : '' }}" t-on-click="() => this.changerPeriode('jour')">Jour</button>
                    <button t-attf-class="o_pp_btn {{ d.periode === 'semaine' ? 'o_pp_actif' : '' }}" t-on-click="() => this.changerPeriode('semaine')">Semaine</button>
                    <button t-attf-class="o_pp_btn {{ d.periode === 'mois' ? 'o_pp_actif' : '' }}" t-on-click="() => this.changerPeriode('mois')">Mois</button>
                </span>
            </div>

            <div class="o_pp_kpis">
                <div class="o_pp_kpi o_pp_k_rose">
                    <span class="o_pp_k_ic">📅</span><div class="o_pp_k_v" t-out="k.total"/>
                    <div class="o_pp_k_t">Tâches sur la période</div>
                    <div class="o_pp_k_s"><span>vs période préc.</span>
                        <b t-if="k.tendance !== false" t-attf-class="{{ k.tendance >= 0 ? 'text-success' : 'text-danger' }}" t-out="(k.tendance > 0 ? '+' : '') + k.tendance + ' %'"/></div>
                </div>
                <div class="o_pp_kpi o_pp_k_orange">
                    <span class="o_pp_k_ic">⏰</span><div class="o_pp_k_v" t-out="k.en_retard"/>
                    <div class="o_pp_k_t">En retard</div><div class="o_pp_k_s"><span>à replanifier</span></div>
                </div>
                <div class="o_pp_kpi o_pp_k_vert">
                    <span class="o_pp_k_ic">👤</span><div class="o_pp_k_v" t-out="k.sans_technicien"/>
                    <div class="o_pp_k_t">Sans technicien</div><div class="o_pp_k_s"><span>à assigner</span></div>
                </div>
                <div class="o_pp_kpi o_pp_k_bleu">
                    <span class="o_pp_k_ic">✅</span><div class="o_pp_k_v" t-out="k.completion + ' %'"/>
                    <div class="o_pp_k_t">Tâches complétées</div>
                    <div class="o_pp_k_s"><span t-out="'vs objectif ' + k.objectif + ' %'"/>
                        <span class="o_pp_k_prog"><span t-attf-style="width: {{ Math.min(k.completion, 100) }}%"/></span>
                        <b t-attf-class="{{ k.completion >= k.objectif ? 'text-success' : 'text-danger' }}" t-out="k.completion + ' %'"/></div>
                </div>
                <div class="o_pp_kpi o_pp_k_menthe">
                    <span class="o_pp_k_ic">🚚</span><div class="o_pp_k_v" t-out="k.livraisons + ' / ' + k.ramassages"/>
                    <div class="o_pp_k_t">Livraisons / ramassages</div><div class="o_pp_k_s"><span>sur la période</span></div>
                </div>
                <div class="o_pp_kpi o_pp_k_violet">
                    <span class="o_pp_k_ic">🛠️</span><div class="o_pp_k_v" t-out="k.entretiens_reparations"/>
                    <div class="o_pp_k_t">Entretiens &amp; réparations</div>
                    <div class="o_pp_k_s"><span t-out="'dont ' + k.reparations + ' réparation' + (k.reparations > 1 ? 's' : '')"/></div>
                </div>
            </div>

            <div class="o_pp_graphs">
                <div class="o_pp_cadre"><h3>Charge par technicien</h3>
                    <GraphiquePlanning t-if="g.charge.series.length" type="'charge'" donnees="g.charge"/>
                    <div t-else="" class="o_pp_vide">Aucune tâche assignée sur la période.</div>
                </div>
                <div class="o_pp_cadre"><h3>Répartition par type</h3>
                    <div class="o_pp_donut" t-if="g.repartition.length">
                        <div class="o_pp_donut_g"><GraphiquePlanning type="'repartition'" donnees="g.repartition"/>
                            <div class="o_pp_donut_c"><b t-out="k.total"/><small>tâches</small></div></div>
                        <div class="o_pp_donut_l">
                            <div t-foreach="g.repartition" t-as="r" t-key="r.nom"><i t-attf-style="background: {{ r.couleur }}"/><span t-out="r.nom"/><b t-out="r.valeur"/></div>
                        </div>
                    </div>
                    <div t-else="" class="o_pp_vide">Aucune tâche sur la période.</div>
                </div>
                <div class="o_pp_cadre"><h3>Tâches faites — 12 dernières semaines</h3>
                    <GraphiquePlanning type="'tendance'" donnees="g.tendance"/>
                </div>
            </div>

            <div t-attf-class="o_pp_grille {{ d.jours.length > 7 ? 'o_pp_mois' : '' }}" t-att-style="this.largeurGrille()">
                <div class="o_pp_tete o_pp_tech">Technicien</div>
                <div t-foreach="d.jours" t-as="jour" t-key="jour.iso" t-attf-class="o_pp_tete {{ jour.aujourdhui ? 'o_pp_auj' : '' }}" t-out="d.jours.length > 7 ? jour.titre.split(' ')[1] : jour.titre"/>
                <t t-foreach="d.lignes" t-as="ligne" t-key="ligne.id">
                    <div t-attf-class="o_pp_tech {{ ligne.id ? '' : 'o_pp_sans' }}">
                        <span class="o_pp_avatar" t-attf-style="background: {{ ligne.couleur }}" t-out="ligne.initiales"/>
                        <div class="o_pp_tech_info">
                            <div class="o_pp_tech_nom" t-out="ligne.nom"/>
                            <small t-if="ligne.id" t-out="ligne.nombre + (ligne.nombre > 1 ? ' tâches' : ' tâche')"/>
                            <small t-elif="ligne.nombre" class="text-danger fw-bold" t-out="ligne.nombre + ' à assigner'"/>
                            <small t-if="ligne.id and ligne.en_retard" class="text-danger fw-bold" t-out="' · ' + ligne.en_retard + ' en retard'"/>
                        </div>
                    </div>
                    <div t-foreach="d.jours" t-as="jour" t-key="jour.iso"
                         t-attf-class="o_pp_case {{ jour.aujourdhui ? 'o_pp_auj' : '' }} {{ jour.weekend ? 'o_pp_we' : '' }} {{ this.state.survol === ligne.id + '-' + jour.iso ? 'o_pp_survol' : '' }}"
                         t-on-dragover="(ev) => this.survoler(ev, ligne, jour)"
                         t-on-drop="(ev) => this.deposer(ev, ligne, jour)">
                        <div t-foreach="this.cartes(ligne, jour)" t-as="c" t-key="c.id"
                             t-attf-class="o_pp_carte o_pp_{{ c.couleur }} {{ c.etat === 'fait' ? 'o_pp_fait' : '' }} {{ c.etat === 'en_retard' ? 'o_pp_retard' : '' }}"
                             t-att-draggable="d.peut_deplacer and c.deplacable ? 'true' : 'false'"
                             t-on-dragstart="(ev) => this.debutGlisser(ev, c)" t-on-dragend="() => this.finGlisser()"
                             t-on-drop.stop="(ev) => this.deposer(ev, ligne, jour, c)"
                             t-on-click="() => this.ouvrir(c)" t-att-title="(c.heure_fixe ? c.pastille : 'Tournée n° ' + c.pastille) + ' · ' + c.libelle_type + ' · ' + (c.client or c.titre)">
                            <t t-if="d.jours.length &lt;= 7">
                                <div class="o_pp_l1"><span t-attf-class="o_pp_pastille {{ c.heure_fixe ? 'o_pp_pastille_fixe' : '' }}" t-out="c.pastille"/><span t-out="c.libelle_type"/>
                                    <span t-if="c.etat === 'fait'" class="ms-1">✓</span>
                                    <span t-if="c.etat === 'en_retard'" class="ms-1">En retard</span>
                                    <span t-if="c.conflit" class="o_pp_conflit" title="Deux tâches à la même heure">Conflit</span></div>
                                <div class="o_pp_l2" t-out="c.client or c.titre"/>
                            </t>
                        </div>
                        <button t-if="d.peut_deplacer and d.jours.length &lt;= 7 and this.cartes(ligne, jour).length"
                                class="o_pp_organiser" t-on-click="() => this.organiser(ligne, jour)"
                                title="Choisir l'ordre de la tournée et les heures fixes">Ordre de la journée</button>
                    </div>
                </t>
            </div>
            <div class="o_pp_legende">
                <span class="o_pp_carte o_pp_success">Livraison</span>
                <span class="o_pp_carte o_pp_warning">Ramassage</span>
                <span class="o_pp_carte o_pp_info">Entretien</span>
                <span class="o_pp_carte o_pp_danger">Réparation</span>
                <span class="o_pp_carte o_pp_primary">Installation</span>
                <span class="ms-2">Cliquez sur une tâche pour l'ouvrir. 1, 2, 3 : ordre de la tournée ; 14h00 : heure fixe.
                    Glissez une tâche sur une autre pour changer l'ordre.</span>
            </div>
        </div>
        </div>
    </div>
</templates>
