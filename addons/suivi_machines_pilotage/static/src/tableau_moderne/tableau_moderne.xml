<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <div t-name="suivi_machines_pilotage.TableauModerne" t-attf-class="o_action o_pilotage_moderne {{ this.state.chargement ? 'o_pm_charge' : '' }}">
        <t t-set="d" t-value="this.state.donnees"/>
        <div class="o_content o_pm_defile">
        <div class="o_pm_wrap" t-if="d">
            <!-- En-tete -->
            <div class="o_pm_head">
                <div>
                    <h1>Bonjour <t t-out="d.bonjour"/></h1>
                    <p><t t-out="d.date"/> · ce qui demande votre attention
                        <span class="o_pm_maj" t-if="this.state.majA">· mis à jour à <t t-out="this.state.majA"/>
                            <a class="o_pm_more ms-1" t-on-click="() => this.charger(this.state.periode)" title="Actualiser">
                                <i class="oi" data-icon="refresh"/></a></span></p>
                </div>
                <div class="o_pm_chips">
                    <button t-attf-class="o_pm_chip {{ this.state.periode === 'jour' ? 'on' : '' }}" t-on-click="() => this.charger('jour')">Aujourd'hui</button>
                    <button t-attf-class="o_pm_chip {{ this.state.periode === 'semaine' ? 'on' : '' }}" t-on-click="() => this.charger('semaine')">7 jours</button>
                    <button t-attf-class="o_pm_chip {{ this.state.periode === 'mois' ? 'on' : '' }}" t-on-click="() => this.charger('mois')">30 jours</button>
                    <button class="o_pm_chip o_pm_lien" t-on-click="() => this.ouvrirAction('suivi_machines_pilotage.action_pilotage_tableau_bord')">
                        <i class="oi me-1" data-icon="bar_chart"/>Toutes les cartes
                    </button>
                </div>
            </div>

            <!-- Grands chiffres -->
            <div class="o_pm_kpis">
                <div t-foreach="d.kpis" t-as="k" t-key="k.code" class="o_pm_kpi" t-on-click="() => this.ouvrir(k.code)">
                    <span t-attf-class="o_pm_tag o_pm_{{ k.tendance_couleur }}" t-if="k.tendance" t-out="k.tendance"/>
                    <div t-attf-class="o_pm_ic o_pm_{{ k.couleur }}"><i class="oi" t-att-data-icon="k.icone"/></div>
                    <div class="o_pm_v" t-out="k.valeur"/>
                    <div class="o_pm_l" t-out="k.libelle"/>
                </div>
            </div>

            <div class="o_pm_grid">
                <!-- A traiter maintenant -->
                <div class="o_pm_card">
                    <h3>À traiter maintenant</h3>
                    <div t-if="!d.alertes.length" class="o_pm_vide"><i class="oi me-1" data-icon="check"/>Rien d'urgent. Bravo !</div>
                    <div t-foreach="d.alertes" t-as="a" t-key="a.code" t-attf-class="o_pm_alerte o_pm_{{ a.niveau }}">
                        <span class="o_pm_n" t-out="a.nombre"/>
                        <div class="o_pm_txt"><b t-out="a.titre"/><span t-out="a.detail"/></div>
                        <button class="o_pm_go" t-on-click="() => this.ouvrir(a.code)" t-out="a.bouton"/>
                    </div>
                </div>

                <!-- Techniciens -->
                <div class="o_pm_card">
                    <h3>Techniciens
                        <a class="o_pm_more" t-on-click="() => this.ouvrirAction('suivi_machines_pilotage.action_portail_techniciens')">Portail →</a></h3>
                    <div t-if="!d.techniciens.length" class="o_pm_vide">Aucune tâche sur la période.</div>
                    <div t-foreach="d.techniciens" t-as="t" t-key="t.id" class="o_pm_tech o_pm_survol" t-on-click="() => this.ouvrir(t.code)" t-att-title="'Voir les tâches de ' + t.nom">
                        <span class="o_pm_av" t-attf-style="background: {{ t.couleur }}" t-out="t.initiales"/>
                        <span class="o_pm_nom" t-out="t.nom"/>
                        <div class="o_pm_bar">
                            <i class="o_pm_g" t-att-style="'width:' + this.largeur(t.fait, t.total)"/>
                            <i class="o_pm_r" t-att-style="'width:' + this.largeur(t.retard, t.total)"/>
                            <i class="o_pm_gy" t-att-style="'width:' + this.largeur(t.a_faire, t.total)"/>
                        </div>
                        <span class="o_pm_c"><t t-out="t.fait"/>/<t t-out="t.total"/></span>
                    </div>
                    <div class="o_pm_leg"><span class="g">Fait</span><span class="r">En retard</span><span class="gy">À faire</span></div>
                    <div class="o_pm_bilan">
                        <div class="o_pm_ring" t-att-style="this.anneau(d.progression)">
                            <div><t t-out="d.progression.pourcentage"/>%<small>fait</small></div>
                        </div>
                        <div class="o_pm_m o_pm_clic" t-on-click="() => this.ouvrirAction('suivi_machines_pilotage.action_portail_techniciens')"><div class="o_pm_v2" t-out="d.progression.total"/><div class="o_pm_l">Tâches</div></div>
                        <div class="o_pm_m"><div class="o_pm_v2 text-danger" t-out="d.progression.retards"/><div class="o_pm_l">En retard</div></div>
                    </div>
                </div>

                <!-- Problemes et appels -->
                <div class="o_pm_card">
                    <h3>Appels par problème <small>30 jours</small></h3>
                    <div t-if="!d.problemes.length" class="o_pm_vide">Aucun appel étiqueté.</div>
                    <div t-foreach="d.problemes" t-as="p" t-key="p.nom" class="o_pm_hb o_pm_survol" t-on-click="() => this.ouvrir(p.code)" t-att-title="'Voir les appels : ' + p.nom">
                        <span class="o_pm_lab" t-out="p.nom"/>
                        <div class="o_pm_bar"><i class="o_pm_violet" t-att-style="'width:' + this.largeur(p.nombre, d.max_probleme)"/></div>
                        <span class="o_pm_num" t-out="p.nombre"/>
                    </div>
                    <h3 class="mt-3">Appels reçus <small>8 semaines</small></h3>
                    <div class="o_pm_spark">
                        <i t-foreach="d.semaines" t-as="s" t-key="s.libelle" t-att-title="'Semaine du ' + s.libelle + ' : ' + s.nombre + ' appel(s)'"
                           t-on-click="() => this.ouvrir(s.code)"
                           t-attf-class="{{ s_last ? 'h' : '' }}" t-att-style="'height:' + Math.max(4, Math.round(100 * s.nombre / d.max_semaine)) + '%'"/>
                    </div>
                    <div class="o_pm_spl"><span t-out="d.semaines[0].libelle"/><span>cette semaine</span></div>
                </div>
            </div>

            <div class="o_pm_grid o_pm_grid2">
                <!-- Prochaines taches -->
                <div class="o_pm_card">
                    <h3>Prochaines tâches
                        <a class="o_pm_more" t-on-click="() => this.ouvrirAction('suivi_machines_pilotage.action_portail_techniciens')">Tout voir →</a></h3>
                    <div t-if="!d.tournees.length" class="o_pm_vide">Rien de prévu sur la période.</div>
                    <div t-foreach="d.tournees" t-as="r" t-key="r.id" class="o_pm_row o_pm_survol" t-on-click="() => this.ouvrir(r.code)">
                        <span class="o_pm_tm" t-out="r.quand"/>
                        <span t-attf-class="badge rounded-pill text-bg-{{ r.couleur }}" t-out="r.type"/>
                        <span class="o_pm_cl"><t t-out="r.client"/><small t-if="r.titre" class="text-muted"> · <t t-out="r.titre"/></small></span>
                        <span class="text-muted" t-out="r.technicien"/>
                    </div>
                </div>
                <!-- Parc -->
                <div class="o_pm_card">
                    <h3>Parc &amp; activité <small>ce mois</small></h3>
                    <div class="o_pm_parc">
                        <div t-foreach="d.parc" t-as="m" t-key="m.code" class="o_pm_m o_pm_clic" t-on-click="() => this.ouvrir(m.code)">
                            <div t-attf-class="o_pm_v2 {{ m.alerte ? 'text-danger' : '' }}" t-out="m.valeur"/>
                            <div class="o_pm_l" t-out="m.libelle"/>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Stock & inventaire -->
            <div class="o_pm_grid o_pm_grid3" t-if="d.stock">
                <div class="o_pm_card">
                    <h3>Parc machines <small>par statut</small></h3>
                    <div t-if="!d.stock.statuts.length" class="o_pm_vide">Aucune machine.</div>
                    <div t-foreach="d.stock.statuts" t-as="x" t-key="x.code" class="o_pm_hb o_pm_survol" t-on-click="() => this.ouvrir(x.code)" t-att-title="'Voir : ' + x.nom">
                        <span class="o_pm_lab" t-out="x.nom"/>
                        <div class="o_pm_bar"><i t-attf-class="o_pm_{{ x.couleur }}" t-att-style="'width:' + this.largeur(x.nombre, d.stock.max_statut)"/></div>
                        <span class="o_pm_num" t-out="x.nombre"/>
                    </div>
                </div>
                <div class="o_pm_card">
                    <h3>Disponibles en entrepôt <small>par modèle</small></h3>
                    <div t-if="!d.stock.disponibles.length" class="o_pm_vide">Aucune machine en entrepôt.</div>
                    <div t-foreach="d.stock.disponibles" t-as="x" t-key="x.code" class="o_pm_hb o_pm_survol" t-on-click="() => this.ouvrir(x.code)" t-att-title="'Voir les machines : ' + x.nom">
                        <span class="o_pm_lab" t-out="x.nom"/>
                        <div class="o_pm_bar"><i class="o_pm_g" t-att-style="'width:' + this.largeur(x.nombre, d.stock.max_dispo)"/></div>
                        <span class="o_pm_num" t-out="x.nombre"/>
                    </div>
                    <h3 class="mt-3">Stock par catégorie
                        <a class="o_pm_more" t-if="d.stock.rupture" t-on-click="() => this.ouvrir('rupture')"><t t-out="d.stock.rupture"/> en rupture →</a></h3>
                    <div t-if="!d.stock.categories.length" class="o_pm_vide">Aucun stock.</div>
                    <div t-foreach="d.stock.categories" t-as="x" t-key="x.code" class="o_pm_hb o_pm_survol" t-on-click="() => this.ouvrir(x.code)" t-att-title="'Voir les produits : ' + x.nom">
                        <span class="o_pm_lab" t-out="x.nom"/>
                        <div class="o_pm_bar"><i class="o_pm_violet" t-att-style="'width:' + this.largeur(x.nombre, d.stock.max_categorie)"/></div>
                        <span class="o_pm_num" t-out="x.nombre"/>
                    </div>
                </div>
                <div class="o_pm_card">
                    <h3>Derniers mouvements de stock
                        <a class="o_pm_more" t-on-click="() => this.ouvrir('mouvements')">Tout voir →</a></h3>
                    <div t-if="!d.stock.mouvements.length" class="o_pm_vide">Aucun mouvement.</div>
                    <div t-foreach="d.stock.mouvements" t-as="m" t-key="m.id" class="o_pm_mvt o_pm_survol" t-on-click="() => this.ouvrir(m.code)">
                        <span t-attf-class="o_pm_sens {{ m.entree ? 'in' : 'out' }}" t-att-title="m.entree ? 'Entrée en stock' : 'Sortie'">
                            <i class="oi" t-att-data-icon="m.entree ? 'south_west' : 'north_east'"/></span>
                        <div class="o_pm_mvt_txt">
                            <b><t t-out="m.produit"/><t t-if="m.serie"> · <t t-out="m.serie"/></t></b>
                            <small class="text-muted"><t t-out="m.de"/> → <t t-out="m.vers"/><t t-if="m.reference"> · <t t-out="m.reference"/></t></small>
                        </div>
                        <span class="o_pm_mvt_q"><t t-out="m.quantite"/><small class="d-block text-muted" t-out="m.quand"/></span>
                    </div>
                </div>
            </div>
        </div>
        </div>
    </div>
</templates>
