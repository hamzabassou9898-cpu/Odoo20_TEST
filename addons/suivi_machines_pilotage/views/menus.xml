<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <menuitem id="menu_pilotage_root" name="Pilotage" sequence="4"
              web_icon="suivi_machines_pilotage,static/description/icon.png"
              groups="suivi_machines_pilotage.group_pilotage"/>
    <!-- Tableau de bord : vue d'ensemble moderne + toutes les cartes (les deux vues) -->
    <menuitem id="menu_pilotage_tableau_racine" name="Tableau de bord" parent="menu_pilotage_root" sequence="1"/>
    <menuitem id="menu_pilotage_tableau_moderne" name="Vue d'ensemble" parent="menu_pilotage_tableau_racine"
              action="action_pilotage_vue_ensemble" sequence="1"/>
    <menuitem id="menu_pilotage_tableau" name="Toutes les cartes" parent="menu_pilotage_tableau_racine"
              action="action_pilotage_tableau_bord" sequence="2"/>

    <!-- Contacts : s'ouvre sur la vue native « Hiérarchie » (chaque société avec ses contacts) -->
    <record id="contacts.action_contacts" model="ir.actions.act_window">
        <field name="view_mode">hierarchy,list,kanban,form,activity</field>
    </record>

    <!-- Contacts, Ventes et CRM : les vues natives d'Odoo, telles quelles -->
    <menuitem id="menu_pilotage_contacts" name="Contacts" parent="menu_pilotage_root"
              action="contacts.action_contacts" sequence="3"/>
    <menuitem id="menu_pilotage_ventes" name="Ventes" parent="menu_pilotage_root"
              action="sale.action_quotations_with_onboarding" sequence="16"/>
    <menuitem id="menu_pilotage_crm" name="CRM" parent="menu_pilotage_root"
              action="crm.crm_lead_action_pipeline" sequence="18"/>

    <!-- Appels de service : la vue complete de l'Assistance (colonnes par etape) -->
    <record id="action_pilotage_appels_assistance" model="ir.actions.server">
        <field name="name">Appels de service</field>
        <field name="model_id" ref="model_pilotage_indicateur"/>
        <field name="state">code</field>
        <field name="code">action = model.action_appels_de_service()</field>
    </record>
    <menuitem id="menu_pilotage_appels" name="Appels de service" parent="menu_pilotage_root"
              action="action_pilotage_appels_assistance" sequence="5"/>
    <!-- Pas de menu « Entretiens & réparations » : tout s'ouvre depuis les cartes du tableau de bord -->

    <!-- Portail techniciens : entree directe de la barre de menu -->
    <menuitem id="menu_pilotage_planning" name="Planning" parent="menu_pilotage_root"
              action="action_pilotage_planning" sequence="14"/>
    <menuitem id="menu_portail_livreurs" name="Portail techniciens" parent="menu_pilotage_root"
              action="action_portail_techniciens" sequence="12"/>
    <menuitem id="menu_pilotage_locations" name="Locations" parent="menu_pilotage_root" sequence="20"/>
    <record id="action_pilotage_nouveau_contrat" model="ir.actions.server">
        <field name="name">Nouveau contrat de location</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="state">code</field>
        <field name="code">action = model.action_nouveau_contrat_location()</field>
    </record>
    <menuitem id="menu_pilotage_nouveau_contrat" name="Nouveau contrat de location" parent="menu_pilotage_locations"
              action="action_pilotage_nouveau_contrat" sequence="0"/>
    <menuitem id="menu_pilotage_contrats" name="Contrats de location" parent="menu_pilotage_locations"
              action="action_pilotage_locations" sequence="1"/>
    <menuitem id="menu_pilotage_types_contrat" name="Types de contrat" parent="menu_pilotage_locations"
              action="suivi_machines.action_types_contrat" sequence="9"/>
    <menuitem id="menu_pilotage_reprises" name="Tickets de reprise" parent="menu_pilotage_locations"
              action="action_pilotage_tickets_reprise" sequence="2"/>
    <menuitem id="menu_pilotage_planifier_ramassage" name="Planifier un ramassage" parent="menu_pilotage_locations"
              action="action_pilotage_planifier_ramassage" sequence="3"/>


    <menuitem id="menu_pilotage_facturation_racine" name="Facturation" parent="menu_pilotage_root" sequence="40"/>
    <menuitem id="menu_pilotage_facturation" name="Interventions à facturer" parent="menu_pilotage_facturation_racine"
              action="action_pilotage_facturation" sequence="1"/>
    <menuitem id="menu_pilotage_sage_clients" name="Clients : à enregistrer dans Sage" parent="menu_pilotage_facturation_racine"
              action="suivi_sage.action_sage_clients" sequence="2"/>
    <menuitem id="menu_pilotage_sage_fournisseurs" name="Fournisseurs : à enregistrer dans Sage" parent="menu_pilotage_facturation_racine"
              action="suivi_sage.action_sage_fournisseurs" sequence="3"/>

    <menuitem id="menu_pilotage_parc" name="Inventaire" parent="menu_pilotage_root" sequence="50"/>
    <menuitem id="menu_pilotage_vue_ensemble" name="Parc machines" parent="menu_pilotage_parc"
              action="suivi_machines.action_vue_ensemble_machines" sequence="1"/>
    <menuitem id="menu_pilotage_toutes" name="Toutes les machines" parent="menu_pilotage_parc"
              action="suivi_machines.action_machines" sequence="2"/>
    <menuitem id="menu_pilotage_livraisons" name="Livraisons" parent="menu_pilotage_parc"
              action="stock.action_picking_tree_outgoing" sequence="3"/>
    <menuitem id="menu_pilotage_transferts_semaine" name="Livraisons &amp; ramassages de la semaine"
              parent="menu_pilotage_parc" action="action_pilotage_transferts" sequence="3"/>
    <menuitem id="menu_pilotage_produits_categorie" name="Produits par catégorie"
              parent="menu_pilotage_parc" action="action_pilotage_produits_categorie" sequence="4"/>
    <menuitem id="menu_pilotage_mouvements" name="Historique des mouvements" parent="menu_pilotage_parc"
              action="stock.stock_move_line_action" sequence="5"/>
    <menuitem id="menu_pilotage_inventaire_physique" name="Inventaire physique (ajustement)" parent="menu_pilotage_parc"
              action="stock.action_view_inventory_tree" sequence="6"/>

</odoo>
