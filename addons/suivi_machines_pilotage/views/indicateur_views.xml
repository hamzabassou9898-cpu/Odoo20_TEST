<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tableau de bord : une carte par indicateur, regroupees par section -->
    <record id="view_pilotage_indicateur_kanban" model="ir.ui.view">
        <field name="name">pilotage.indicateur.kanban</field>
        <field name="model">pilotage.indicateur</field>
        <field name="arch" type="xml">
            <kanban create="false" edit="false" delete="false" default_group_by="section"
                    group_create="false" group_delete="false" group_edit="false"
                    records_draggable="false" quick_create="false"
                    action="action_ouvrir" type="object">
                <field name="couleur"/>
                <field name="valeur"/>
                <field name="repartition"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="border-start border-4 border-{{record.couleur.raw_value}} ps-3 py-1">
                            <div class="text-uppercase small fw-bold text-muted">
                                <field name="name"/>
                            </div>
                            <div t-attf-class="fw-bold text-{{record.couleur.raw_value}}" style="font-size: 2.6rem; line-height: 1.1;">
                                <field name="valeur"/>
                            </div>
                            <div class="small text-muted">
                                <field name="sous_titre"/>
                            </div>
                            <!-- Detail par type : une etiquette par type de ticket -->
                            <div t-if="record.repartition.raw_value" class="d-flex flex-wrap gap-1 mt-1">
                                <t t-foreach="record.repartition.raw_value" t-as="r" t-key="r_index">
                                    <!-- « Réparation » : clic = la liste des réparations de la carte -->
                                    <button t-if="r[3] == 'reparations'" name="action_ouvrir_reparations" type="object"
                                            t-attf-class="badge rounded-pill border-0 text-bg-{{r[2]}}">
                                        <t t-out="r[0]"/> : <t t-out="r[1]"/>
                                    </button>
                                    <!-- « Machine à remplacer » : clic = les machines à remplacer de la carte -->
                                    <button t-elif="r[3] == 'remplacements'" name="action_ouvrir_remplacements" type="object"
                                            t-attf-class="badge rounded-pill border-0 text-bg-{{r[2]}}">
                                        <t t-out="r[0]"/> : <t t-out="r[1]"/>
                                    </button>
                                    <!-- Livraisons & ramassages faits : clic = la liste du mois -->
                                    <button t-elif="r[3] == 'livrees'" name="action_ouvrir_livrees" type="object"
                                            t-attf-class="badge rounded-pill border-0 text-bg-{{r[2]}}">
                                        <t t-out="r[0]"/> : <t t-out="r[1]"/>
                                    </button>
                                    <button t-elif="r[3] == 'ramassees'" name="action_ouvrir_ramassees" type="object"
                                            t-attf-class="badge rounded-pill border-0 text-bg-{{r[2]}}">
                                        <t t-out="r[0]"/> : <t t-out="r[1]"/>
                                    </button>
                                    <span t-else="" t-attf-class="badge rounded-pill text-bg-{{r[2]}}">
                                        <t t-out="r[0]"/> : <t t-out="r[1]"/>
                                    </span>
                                </t>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_pilotage_tableau_bord" model="ir.actions.act_window">
        <field name="name">Tableau de bord</field>
        <field name="res_model">pilotage.indicateur</field>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="view_pilotage_indicateur_kanban"/>
    </record>

    <!-- Planning de la semaine : techniciens x jours, glisser-deposer -->
    <record id="action_pilotage_planning" model="ir.actions.client">
        <field name="name">Planning</field>
        <field name="tag">suivi_pilotage_planning</field>
    </record>

    <!-- Vue d'ensemble moderne (la vue « Toutes les cartes » reste disponible) -->
    <record id="action_pilotage_vue_ensemble" model="ir.actions.client">
        <field name="name">Vue d'ensemble</field>
        <field name="tag">suivi_pilotage_tableau_moderne</field>
    </record>
</odoo>
