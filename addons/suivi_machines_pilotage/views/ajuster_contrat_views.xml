<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ajuster_contrat_form" model="ir.ui.view">
        <field name="name">suivi.ajuster.contrat.form</field>
        <field name="model">suivi.ajuster.contrat</field>
        <field name="arch" type="xml">
            <form string="Ajuster le contrat">
                <group>
                    <group>
                        <field name="contrat_id" options="{'no_create': True}"/>
                        <field name="partner_id" invisible="not contrat_id"/>
                        <field name="date_fin_actuelle" invisible="not contrat_id"/>
                    </group>
                    <group>
                        <field name="machines_actuelles_ids" widget="many2many_tags" invisible="not contrat_id"/>
                    </group>
                </group>
                <div invisible="not contrat_id">
                    <separator string="1. Ajouter des machines (en entrepôt)"/>
                    <field name="machine_ids" widget="many2many_tags" options="{'no_create': True}"
                           placeholder="Numéros de série à livrer en plus"/>
                    <separator string="2. Ajouter des accessoires"/>
                    <field name="accessoire_ids">
                        <list editable="bottom">
                            <field name="product_id" options="{'no_create': True}"/>
                            <field name="quantite"/>
                        </list>
                    </field>
                    <separator string="3. Renouveler (même contrat)"/>
                    <group>
                        <field name="renouveler"/>
                        <field name="nouvelle_date_fin" invisible="not renouveler" required="renouveler"/>
                        <field name="note" placeholder="ex. renouvellement 2 ans, même prix"/>
                    </group>
                </div>
                <footer>
                    <button name="action_appliquer" type="object" string="Appliquer" class="btn-primary"
                            invisible="not contrat_id"/>
                    <button string="Annuler" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_ajuster_contrat" model="ir.actions.act_window">
        <field name="name">Ajuster un contrat</field>
        <field name="res_model">suivi.ajuster.contrat</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Bouton sur le contrat de location confirme -->
    <record id="view_order_form_ajuster_contrat" model="ir.ui.view">
        <field name="name">sale.order.form.ajuster.contrat</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_ajuster_contrat" type="object" string="Ajuster le contrat"
                        class="btn-secondary" invisible="type_commande != 'location' or state != 'sale'"
                        groups="sales_team.group_sale_salesman"/>
            </xpath>
        </field>
    </record>
</odoo>
